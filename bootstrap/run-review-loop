#!/usr/bin/env bash
# Review, unattended: discover assigned PRs, build their graphs, publish
# finished verdicts. One loop, same shape as run-notifier: a crash is a
# restarting container, not a silently missing cron job.
#
# Scope is the allowlist file bootstrap/cutover-repo writes; empty or absent
# means discover-reviews refuses and nothing is admitted. publish-review is
# idempotent by its marker, so re-running it on an already-posted card is a
# no-op; cards are never archived here, because archiving frees their keys
# and would review the same head again.

set -uo pipefail

BOARD=${RALPH_REVIEW_BOARD:-queues}
INTERVAL=${RALPH_REVIEW_POLL_SECONDS:-900}
CACHE=${RALPH_REPO_CACHE:-/workspaces/repo-cache}
WORK=${RALPH_REVIEW_WORK:-/workspaces/review-work}
PUBLISHED=${RALPH_REVIEW_PUBLISHED:-$WORK/.published}

# Scope. RALPH_REVIEW_ALLOW / RALPH_MAINTAIN_ALLOW (space separated, owner/*
# allowed) are written to a file so every reader below stays file-based; set,
# they override the files bootstrap/cutover-repo writes.
inline_allow() {
    local out="${TMPDIR:-/tmp}/ralph-$1-allow.txt"
    tr -s ' ' '\n' <<<"$2" | sed '/^$/d' >"$out"
    echo "$out"
}
if [ -n "${RALPH_REVIEW_ALLOW:-}" ]; then
    ALLOW=$(inline_allow review "$RALPH_REVIEW_ALLOW")
else
    ALLOW=${RALPH_REVIEW_ALLOWLIST:-/workspaces/review-allowlist.txt}
fi
# Maintenance pushes code, so it can be scoped tighter than review. Defaults
# to the review allowlist.
if [ -n "${RALPH_MAINTAIN_ALLOW:-}" ]; then
    MAINTAIN_ALLOW=$(inline_allow maintain "$RALPH_MAINTAIN_ALLOW")
else
    MAINTAIN_ALLOW=${RALPH_MAINTAIN_ALLOWLIST:-/workspaces/maintain-allowlist.txt}
    [ -f "$MAINTAIN_ALLOW" ] || MAINTAIN_ALLOW=$ALLOW
fi

# Identity. A token for the wrong account would review and push as someone
# else, so refuse to start. An unreachable GitHub is not a wrong account:
# retry rather than crash-loop on a network blip.
if [ -n "${RALPH_GITHUB_LOGIN:-}" ]; then
    until who=$(gh api user --jq .login 2>/dev/null) && [ -n "$who" ]; do
        echo "review loop: could not reach GitHub to check RALPH_GITHUB_LOGIN; retrying in 60s" >&2
        sleep 60
    done
    if [ "$who" != "$RALPH_GITHUB_LOGIN" ]; then
        echo "review loop: GH_TOKEN authenticates as '${who}', not RALPH_GITHUB_LOGIN '${RALPH_GITHUB_LOGIN}'; refusing to start" >&2
        exit 1
    fi
fi

echo "ralph review loop: board=${BOARD} every ${INTERVAL}s allowlist=${ALLOW}"

while true; do
    # Publish before discovering: a synthesis that finished since the last
    # pass is posted first, so discovery never sees a done-but-unposted
    # review and admits a newer head on top of it.
    ids=$(docker exec "$RALPH_HERMES_CONTAINER" hermes kanban --board "$BOARD" list \
            --assignee ralph-review-synthesis --status done --json 2>/dev/null \
          | python3 -c 'import json,sys; d=json.load(sys.stdin); [print(t["id"]) for t in (d if isinstance(d,list) else d.get("tasks",[]))]' \
          || true)
    # A card that reached a final outcome -- posted, already posted, head
    # moved (0), refused permanently (2), or an ambiguous POST left for a
    # human (3) -- is not re-checked: re-checking every done card each pass
    # made one pass take many minutes, and re-running 3 risks a duplicate
    # review. Errors (1) are retried. The list lives with the staged evidence.
    for id in $ids; do
        grep -qxF "$id" "$PUBLISHED" 2>/dev/null && continue
        python3 /ralph/bootstrap/publish-review --task "$id" --board "$BOARD" --post
        rc=$?
        case $rc in
            0|2|3) echo "$id" >> "$PUBLISHED" ;;
            *) echo "review loop: publish $id returned $rc" >&2 ;;
        esac
    done

    python3 /ralph/bootstrap/discover-reviews --allow-file "$ALLOW" \
        --checkout-root "$CACHE" --work-root "$WORK" --board "$BOARD" --once-for-real \
        || echo "review loop: discover failed (rc=$?), will retry" >&2

    # Maintenance: PRs authored by RALPH_MAINTAIN_LOGIN in allowlisted repos.
    # maintain-pr excludes that login's own feedback, so Ralph's reviews (as
    # the stack account) are what it acts on. Design-doc PRs belong to the
    # author loop, including after the watcher removes dd-changes.
    if [ -n "${RALPH_MAINTAIN_LOGIN:-}" ] && [ -s "$MAINTAIN_ALLOW" ]; then
        maintenance_exclusions=(-label:dd-changes)
        [ -n "${RALPH_DOCS_REPO:-}" ] && maintenance_exclusions+=("-repo:$RALPH_DOCS_REPO")
        gh search prs --author "$RALPH_MAINTAIN_LOGIN" --state open --limit 200 \
            --json repository,number --jq '.[] | "\(.repository.nameWithOwner) \(.number)"' \
            -- "${maintenance_exclusions[@]}" 2>/dev/null \
        | while read -r repo num; do
            owner=${repo%%/*}
            grep -qxF -e "$repo" -e "$owner/*" "$MAINTAIN_ALLOW" || continue
            python3 /ralph/bootstrap/maintain-pr --once --repo "$repo" --pr "$num" \
                --board "$BOARD" --login "$RALPH_MAINTAIN_LOGIN" \
                || echo "review loop: maintain $repo#$num returned $?" >&2
        done
    fi

    # Sandbox disk cleanup (#97), at most hourly. Never fails the loop.
    stamp="$WORK/.cleanup-stamp"
    if [ -z "$(find "$stamp" -mmin -60 2>/dev/null)" ]; then
        python3 /ralph/bootstrap/cleanup-sandboxes --root "${RALPH_SANDBOX_DIR:-/workspaces/sandboxes}" \
            && touch "$stamp" || echo "review loop: cleanup returned $?" >&2
    fi

    # Knowledge index refresh (#121, #130), at most hourly, or sooner when the
    # docs repository's default branch has moved (dd-ralph-librarian 3.4). A
    # failed refresh leaves .knowledge-head unchanged, so the next poll
    # retries instead of recording a head it never actually indexed.
    kstamp="$WORK/.knowledge-stamp"
    khead="$WORK/.knowledge-head"
    kc="${RALPH_HERMES_CONTAINER%-hermes-1}-knowledge-1"
    if [ "$(docker inspect -f '{{.State.Running}}' "$kc" 2>/dev/null)" = true ]; then
        remote_head=""
        [ -n "${RALPH_DOCS_REPO:-}" ] \
            && remote_head=$(gh api "repos/$RALPH_DOCS_REPO/commits/HEAD" --jq .sha 2>/dev/null)
        if [ -z "$(find "$kstamp" -mmin -60 2>/dev/null)" ] \
                || { [ -n "$remote_head" ] && [ "$remote_head" != "$(cat "$khead" 2>/dev/null)" ]; }; then
            touch "$kstamp"
            if docker exec -e GH_TOKEN -e "KNOWLEDGE_REPO=${RALPH_DOCS_REPO:-}" "$kc" /ralph/bootstrap/refresh-knowledge; then
                [ -n "$remote_head" ] && printf '%s' "$remote_head" > "$khead"
            else
                echo "review loop: knowledge refresh returned $?" >&2
            fi
        fi
    fi

    # Librarian's weekly card (#130, dd-ralph-librarian 2.1, 3.5): one card a
    # week on $BOARD, assigned to ralph-librarian. No docs repository, no
    # card -- no new switch. Never two runs at once: skipped this poll while an
    # open pull request has a librarian/ head, or while a librarian card is
    # still queued, running or blocked. A guard that cannot be read is not
    # "no overlap": a failed query skips the poll and the next one retries.
    if [ -n "${RALPH_DOCS_REPO:-}" ]; then
        lstamp="$WORK/.librarian-stamp"
        if [ -z "$(find "$lstamp" -mmin -10080 2>/dev/null)" ]; then
            lheads=""; lopen=""
            if lheads=$(gh pr list --repo "$RALPH_DOCS_REPO" --state open --limit 100 \
                        --json headRefName --jq '.[].headRefName' 2>/dev/null) \
                    && lopen=$(docker exec "$RALPH_HERMES_CONTAINER" hermes kanban --board "$BOARD" list \
                        --assignee ralph-librarian --json 2>/dev/null \
                    | python3 -c 'import json,sys; d=json.load(sys.stdin); t=d if isinstance(d,list) else d.get("tasks",[]); print(sum(1 for c in t if c.get("status") not in ("done","archived")))'); then
                if printf '%s\n' "$lheads" | grep -q '^librarian/' || [ "${lopen:-0}" -gt 0 ]; then
                    :  # a run is still open: this week's card waits
                elif docker exec "$RALPH_HERMES_CONTAINER" hermes kanban --board "$BOARD" create \
                        "librarian: weekly pass, $(date -u +%F)" \
                        --assignee ralph-librarian \
                        --body "Docs repository: $RALPH_DOCS_REPO"; then
                    touch "$lstamp"
                else
                    echo "review loop: librarian card create returned $?" >&2
                fi
            else
                echo "review loop: librarian overlap check failed; skipping this poll" >&2
            fi
        fi
    fi

    # --once: one pass now instead of waiting up to INTERVAL for the next,
    # e.g. `docker compose exec review-loop /ralph/bootstrap/run-review-loop --once`.
    [ "${1:-}" = "--once" ] && break
    sleep "$INTERVAL"
done
