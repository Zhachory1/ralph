#!/usr/bin/env python3
"""Discover open pull requests assigned to this account and hand each one off
to review-workflow, which builds the review graph.

PR 6 of the fleet-into-ralph design. The first thing in this whole design that
acts without a human present, and the only one that can spend money
unattended.

    bootstrap/discover-reviews --allow owner/repo [--allow owner/repo2] \
        --checkout-root /workspaces/repo-cache --work-root /workspaces/review-work

--allow-file <path> is an alternative to repeated --allow flags: a flat file
of owner/repo lines, read fresh on every invocation. bootstrap/cutover-repo
(PR 7) writes this file, so moving a repository's review scope into Ralph
takes effect on the next tick with no restart here. The two can be combined;
at least one is required, or this refuses rather than silently discovering
nothing from an empty scope.

Run on a timer (cron, a sidecar loop) once this has been watched manually for
a while. --once-for-real is required to let it hand a discovered head off to
review-workflow; every other flag works without it, so a dry run of the
discovery and filtering logic alone never needs that acknowledgement.

NO CAP ON REVIEW ROUNDS, BY DIRECT INSTRUCTION (2026-11-04, replacing the
3-round cap of 85e98c2). Each head is reviewed once: a head this account
already reviewed is never reviewed again. One review per PR runs at a time.

NO DAILY CAP, BY DIRECT INSTRUCTION. Every assigned PR gets reviewed, not a
count held low on purpose. The lever against a real backlog flood is
concurrency: kanban.max_in_progress bounds how many cards run at once
regardless of how many are queued, so a flood drains over hours rather than
minutes, which still gives a human time to notice and stop a genuine runaway
without throttling healthy throughput at an arbitrary number.

Two bounds remain, each enforced here rather than left to the caller's
judgement:

  --max-per-run (default 10)   caps how many PRs one invocation can admit,
                                regardless of how many gh search prs returns
  --max-age-days (default 7)   gh search prs' own --updated filter; a PR that
                                has not moved in a week was not assigned
                                yesterday, so discovering it today is not
                                urgent and widens the backlog a cold start
                                could import
  --allow (repeatable)         an explicit allowlist: owner/repo, or
                                owner/* for every repo of one owner (how
                                bootstrap/cutover-repo moves a whole owner
                                grant). No "all accessible repos" mode
                                exists -- the fleet's board-engine shape,
                                with no per-repo dial, is the design's
                                rejected alternative (section 4)

A PR already admitted is a no-op. This is checked here, not inferred from
the handoff card's own creation: `hermes kanban create` gives no
new-vs-existing signal, since the output looks the same whether the
idempotency key created a card or matched an existing one. Instead this
checks whether the operation's staging directory already existed before
this run touched it. Staging now happens inside review-workflow, not here,
so this directory appears one run later than it used to -- `admitted`
(a reporting count only, not a correctness gate: `review_graphs()`'s own
board check above is what actually prevents a second graph) undercounts
by at most one run's worth of now-staged-but-not-yet-admitted operations,
self-correcting the next time this runs.
"""
import argparse
import datetime
import json
import os
import pathlib
import shutil
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent

sys.path.insert(0, str(HERE))
from importlib.machinery import SourceFileLoader
_stage = SourceFileLoader("stage_review_evidence", str(HERE / "stage-review-evidence")).load_module()
operation_id = _stage.operation_id


def hermes_argv(*args):
    """Same bridge as bootstrap/publish-review and notifier/poller.py, and the
    same HERMES_HOME bug fixed there: forward it only when the caller has it
    set, never blank out a value the target container already has."""
    container = os.environ.get("RALPH_HERMES_CONTAINER")
    if container:
        home = os.environ.get("HERMES_HOME")
        extra = ["-e", f"HERMES_HOME={home}"] if home else []
        return ["docker", "exec", *extra, container, "hermes", *args]
    return ["hermes", *args]


def gh(*args, timeout: int = 90) -> subprocess.CompletedProcess:
    """A timeout is a failed call, not an exception: one slow clone of a
    large repository (ROKT/ml) used to crash the whole pass, every pass."""
    try:
        return subprocess.run(["gh", *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 1, stdout="", stderr=f"gh timed out after {timeout}s")


# A first clone of a multi-GB repository takes minutes, not seconds.
CLONE_TIMEOUT = 1200


def search_assigned_prs(max_age_days: int) -> list[dict] | None:
    """None means the search itself failed; [] means it succeeded and found
    nothing. Found by the review council: both used to return [], so a gh
    auth failure or a network outage under a cron-driven run looked
    identical to "no PRs assigned today" and main() always exited 0 either
    way -- a scheduled run silently stops discovering anything and nothing
    says so."""
    cutoff = (datetime.datetime.now(datetime.timezone.utc)
             - datetime.timedelta(days=max_age_days)).strftime("%Y-%m-%d")
    args = ["search", "prs", "--assignee", "@me", "--state", "open",
           "--json", "number,title,url,repository,updatedAt", "--limit", "1000",
           "--updated", f">={cutoff}"]
    r = gh(*args)
    if r.returncode != 0:
        print(f"error: gh search prs failed: {r.stderr.strip()[:300]}", file=sys.stderr)
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        print(f"error: gh search prs returned unparseable output", file=sys.stderr)
        return None


def pr_shas(repo: str, number: int) -> tuple[str, str] | None:
    r = gh("pr", "view", str(number), "-R", repo, "--json", "baseRefOid,headRefOid")
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
        return data["baseRefOid"], data["headRefOid"]
    except (json.JSONDecodeError, KeyError):
        return None


def pr_text(repo: str, number: int) -> str:
    """Title and description, for the lenses: what the PR says it does and
    does not do. Empty on failure -- the review still runs on the diff."""
    r = gh("pr", "view", str(number), "-R", repo, "--json", "title,body")
    if r.returncode != 0:
        return ""
    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return ""
    return f"# {data.get('title') or ''}\n\n{data.get('body') or ''}\n"


def pr_checks(repo: str, number: int) -> str | None:
    """CI checks on the PR's head: name, outcome, link, never logs. None on
    any failure -- the review still runs, without this file."""
    r = gh("pr", "checks", str(number), "-R", repo, "--json", "name,bucket,state,link,workflow")
    # gh exits 8 while checks are pending, with valid JSON on stdout.
    try:
        return json.dumps(json.loads(r.stdout), indent=1, sort_keys=True)
    except json.JSONDecodeError:
        return None


THREADS_QUERY = """query($owner:String!,$name:String!,$number:Int!){
 repository(owner:$owner,name:$name){pullRequest(number:$number){
  reviewThreads(first:100){nodes{isResolved isOutdated path line
   comments(first:50){nodes{author{login} body}}}}
  comments(first:100){nodes{author{login} body}}
  reviews(first:100){nodes{author{login} state body}}}}}"""


def pr_threads(repo: str, number: int) -> str | None:
    """Review threads, PR comments and review bodies, as markdown. Excludes
    this instance's own account: re-reading its own earlier findings would
    only echo them back as someone else's. None on any failure."""
    owner, name = repo.split("/", 1)
    r = gh("api", "graphql", "-f", f"query={THREADS_QUERY}", "-F", f"owner={owner}",
          "-F", f"name={name}", "-F", f"number={number}")
    try:
        pr = json.loads(r.stdout)["data"]["repository"]["pullRequest"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None
    me = _login().lower()

    def who(node):
        return ((node.get("author") or {}).get("login") or "ghost")

    def mine(node):
        return who(node).lower() == me

    out = []
    for t in pr["reviewThreads"]["nodes"]:
        cs = [c for c in t["comments"]["nodes"] if not mine(c) and (c.get("body") or "").strip()]
        if not cs:
            continue
        state = "resolved" if t["isResolved"] else ("outdated" if t["isOutdated"] else "open")
        out.append(f"## thread on {t.get('path')}:{t.get('line')} ({state})")
        out += [f"**{who(c)}:** {c['body'].strip()}\n" for c in cs]
    for rv in pr["reviews"]["nodes"]:
        if not mine(rv) and (rv.get("body") or "").strip():
            out.append(f"## review by {who(rv)} ({rv['state']})\n{rv['body'].strip()}\n")
    for c in pr["comments"]["nodes"]:
        if not mine(c) and (c.get("body") or "").strip():
            out.append(f"## comment by {who(c)}\n{c['body'].strip()}\n")
    return "\n".join(out) + "\n" if out else ""


def ensure_checkout(root: pathlib.Path, repo: str, number: int, base_sha: str,
                    head_sha: str) -> pathlib.Path | None:
    """One cached clone per repository under root, fetched on demand.

    Cloned without a working tree -- stage-review-evidence only needs the
    two commits to diff, never a checked-out file -- but with every blob. --checkout-root must be
    the same path inside the hermes container, where review-workflow reads
    it (the compose stack mounts ./workspaces at /workspaces in both).
    """
    path = root / repo
    if not (path / ".git").exists() and not (path / "HEAD").exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        # Full objects, not --filter=blob:none: the diff runs later inside the
        # hermes container, which has no GitHub credential, so a lazy blob
        # fetch there fails on any private repository.
        r = gh("repo", "clone", repo, str(path), "--", "--no-checkout", timeout=CLONE_TIMEOUT)
        if r.returncode != 0:
            print(f"  skip {repo}#{number}: clone failed: {r.stderr.strip()[:200]}", file=sys.stderr)
            # A half-written clone has .git, so the next pass would skip the
            # clone and fetch into a broken repository.
            shutil.rmtree(path, ignore_errors=True)
            return None
    # gh as the credential helper, per call: gh repo clone authenticates
    # the clone itself but leaves no helper behind, so a plain git fetch of
    # a private repository fails asking for a username.
    try:
        # gc.pruneExpire=never: sandboxes borrow these objects through
        # `git clone --reference`, and an auto-gc that pruned one would break
        # every checkout still pointing at it. Passed to the auto-gc fetch spawns.
        r = subprocess.run(["git", "-c", "credential.helper=", "-c", "credential.helper=!gh auth git-credential",
                            "-c", "gc.pruneExpire=never",
                            "-C", str(path), "fetch", "--quiet", "origin",
                            base_sha, f"+refs/pull/{number}/head:refs/remotes/pr/{number}"],
                           capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        r = subprocess.CompletedProcess([], 1, stdout="", stderr="git fetch timed out after 300s")
    if r.returncode != 0:
        print(f"  skip {repo}#{number}: fetch failed: {r.stderr.strip()[:200]}", file=sys.stderr)
        return None
    return path


def reviews_by_me(repo: str, number: int) -> dict[str, float] | None:
    """Heads this account has already submitted a review on, one per round,
    each with its newest review's epoch time. Any review counts, not only
    marked ones -- the fleet posts under the same account without Ralph's
    marker, and its rounds are rounds too. None means the read failed."""
    r = gh("api", "--paginate", f"repos/{repo}/pulls/{number}/reviews", "--jq",
           f'.[] | select(.state != "PENDING") | select(.user.login == "{_login()}") '
           f'| "\\(.commit_id) \\(.submitted_at)"')
    if r.returncode != 0:
        return None
    heads: dict[str, float] = {}
    for line in r.stdout.splitlines():
        sha, _, at = line.partition(" ")
        try:
            when = datetime.datetime.fromisoformat(at.replace("Z", "+00:00")).timestamp()
        except ValueError:
            when = 0.0
        heads[sha] = max(heads.get(sha, 0.0), when)
    return heads


_LOGIN = None


def _synthesis_cards(board: str, repo: str, number: int) -> list[dict] | None:
    """This PR's synthesis cards, archived ones included. None means the board
    could not be read."""
    r = subprocess.run(hermes_argv("kanban", "--board", board, "list", "--archived",
                                   "--assignee", "ralph-review-synthesis", "--json"),
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        cards = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None
    cards = cards if isinstance(cards, list) else cards.get("tasks", [])
    prefix = f"Synthesize review {repo}#{number} @ "
    return [c for c in cards if c.get("title", "").startswith(prefix)]


def intake_in_flight(board: str, repo: str, number: int, head_sha: str) -> bool | None:
    """Whether this head's own review-workflow intake card already exists
    and is not blocked. review_graphs() sees only synthesis cards -- an
    intake that has not yet built one is invisible to it (review council,
    three lenses: a repeat discovery pass re-finding a ready/running intake
    by its stable idempotency key must not spend a fresh admission slot
    just because no synthesis card exists to say otherwise). None means the
    board could not be read, treated as not-in-flight so a transient read
    failure does not block an otherwise-eligible head forever."""
    r = subprocess.run(hermes_argv("kanban", "--board", board, "list", "--archived",
                                   "--assignee", "ralph-review-workflow", "--json"),
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        cards = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None
    cards = cards if isinstance(cards, list) else cards.get("tasks", [])
    title = f"Review {repo}#{number} @ {head_sha[:8]}"
    return any(c.get("title") == title and c.get("status") not in ("blocked", "archived")
              for c in cards)


def review_graphs(board: str, repo: str, number: int) -> tuple[set[str], bool] | None:
    """Heads (8-char prefixes) this PR already has a review graph for, and
    whether one is still running. None means the board could not be read,
    and the PR is skipped this pass, as for unreadable reviews.

    A blocked card is not running: it waits for a human and never finishes on
    its own, so counting it held back every later head of the PR indefinitely.
    Its own head still counts as having a graph, so it is not rebuilt."""
    mine = _synthesis_cards(board, repo, number)
    if mine is None:
        return None
    prefix = f"Synthesize review {repo}#{number} @ "
    return ({c["title"][len(prefix):][:8] for c in mine},
            any(c.get("status") not in ("done", "archived", "blocked") for c in mine))


def stale_blocked_synthesis(board: str, repo: str, number: int, head_sha: str) -> list[str]:
    """Ids of this PR's blocked synthesis cards for heads other than head_sha.
    A blocked card stays resumable, so unblocking an old one after a newer head
    was admitted would run a second review for one PR. Empty when the board
    cannot be read: nothing is archived on a guess."""
    mine = _synthesis_cards(board, repo, number)
    prefix = f"Synthesize review {repo}#{number} @ "
    return [c["id"] for c in mine or []
            if c.get("status") == "blocked" and c["title"][len(prefix):][:8] != head_sha[:8]]


def _login() -> str:
    global _LOGIN
    if _LOGIN is None:
        _LOGIN = gh("api", "user", "--jq", ".login").stdout.strip()
    return _LOGIN


def _staging_dir_exists(path: pathlib.Path) -> bool:
    """Checks the filesystem review-workflow actually staged into, not
    this process's own.

    review-workflow runs inside the hermes container when
    RALPH_HERMES_CONTAINER is set (its Kanban workspace paths only resolve
    there), so a prior run's staging directory lives on the container's
    filesystem, not the host's -- this script itself runs wherever gh lives,
    which is the host. --work-root is the same path string on both sides by
    convention, but the same string is two different directories. Checking
    path.is_dir() here, on the host, against a directory the container
    created was always False: 'already staged' never fired.
    """
    container = os.environ.get("RALPH_HERMES_CONTAINER")
    if not container:
        return path.is_dir()
    r = subprocess.run(["docker", "exec", container, "test", "-d", str(path)],
                       capture_output=True, timeout=30)
    return r.returncode == 0


def _positive_int(value: str) -> int:
    """Every bound in this script is a ceiling, and a nonpositive one is not
    a smaller ceiling, it is a hole: allowed[:budget] with a negative budget
    admits almost the entire eligible list instead of enforcing one."""
    n = int(value)
    if n <= 0:
        raise argparse.ArgumentTypeError(f"must be a positive integer, got {value!r}")
    return n


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--allow", action="append", default=[], dest="allowlist",
                    metavar="owner/repo",
                    help="repeatable; a PR outside this list is never admitted, "
                         "no matter what gh search prs returns")
    ap.add_argument("--allow-file", type=pathlib.Path,
                    help="a flat file of owner/repo lines, one per line, read "
                         "fresh on every invocation -- not cached, not read once "
                         "at process start. bootstrap/cutover-repo writes this "
                         "file, so a cutover takes effect on the next tick with "
                         "no restart, the same way the fleet's own authority "
                         "file is re-read on its own schedule. Merged with "
                         "--allow if both are given.")
    ap.add_argument("--checkout-root", required=True, type=pathlib.Path,
                    help="directory holding one cached clone per repository, "
                         "created and fetched on demand; must be the same path "
                         "inside the hermes container")
    ap.add_argument("--work-root", required=True, type=pathlib.Path)
    ap.add_argument("--board", default="lenses")
    ap.add_argument("--max-per-run", type=_positive_int, default=10)
    ap.add_argument("--max-age-days", type=_positive_int, default=7)
    ap.add_argument("--once-for-real", action="store_true",
                    help="required to actually hand a discovered head off to "
                         "review-workflow; without it, this reports what it "
                         "would admit and exits 0")
    args = ap.parse_args()

    allowlist = list(args.allowlist)
    if args.allow_file is not None:
        if args.allow_file.is_file():
            allowlist += [line.strip() for line in args.allow_file.read_text().splitlines()
                         if line.strip() and not line.strip().startswith("#")]
        # A missing allow-file is not an error: bootstrap/cutover-repo may not
        # have run yet, and an empty allowlist already fails closed below --
        # admitting nothing is the safe default, not a crash.
    args.allowlist = sorted(set(allowlist))
    if not args.allowlist:
        print("error: no repos in scope (--allow and --allow-file both empty); "
             "nothing to discover", file=sys.stderr)
        return 2

    args.work_root.mkdir(parents=True, exist_ok=True)

    prs = search_assigned_prs(args.max_age_days)
    if prs is None:
        # A failed search and "nothing assigned today" must not look the
        # same to a scheduler: exit non-zero so a cron wrapper notices
        # and alerts, rather than silently discovering nothing forever.
        print("error: gh search prs failed; discovering nothing this run",
             file=sys.stderr)
        return 1
    print(f"gh search found {len(prs)} open assigned PR(s) within "
         f"{args.max_age_days} day age filter")

    allowed, skipped_not_allowed = [], 0
    for pr in prs:
        repo = pr.get("repository", {}).get("nameWithOwner", "")
        if repo in args.allowlist or f"{repo.split('/')[0]}/*" in args.allowlist:
            allowed.append(pr)
        else:
            skipped_not_allowed += 1
    print(f"  {len(allowed)} in the allowlist, {skipped_not_allowed} skipped "
         f"(not in --allow)")

    # The per-run cap counts only PRs whose current head still needs a
    # review. A head already reviewed or already on the board takes no slot: with
    # the cap applied first, 10 already-reviewed PRs filled every pass and
    # the other 90 assigned PRs were never reached.
    admitted = 0
    slots = 0
    for pr in allowed:
        if slots >= args.max_per_run:
            print(f"  per-run cap {args.max_per_run} reached; the rest wait for the next pass")
            break
        repo = pr["repository"]["nameWithOwner"]
        number = pr["number"]
        shas = pr_shas(repo, number)
        if shas is None:
            print(f"  skip {repo}#{number}: could not read base/head SHAs", file=sys.stderr)
            continue
        base_sha, head_sha = shas
        heads = reviews_by_me(repo, number)
        if heads is None:
            print(f"  skip {repo}#{number}: could not read its reviews", file=sys.stderr)
            continue
        # Already reviewed at this head: settled, and takes no slot.
        if head_sha in heads:
            continue
        # Each head is reviewed once (deduped by head SHA), with no cap on
        # rounds. One review graph per PR runs at a time: a newer head waits
        # for it, then the latest head is reviewed.
        if not args.once_for_real:
            slots += 1
            print(f"  {repo}#{number} @ {head_sha[:8]}")
            continue
        board_view = review_graphs(args.board, repo, number)
        if board_view is None:
            print(f"  skip {repo}#{number}: could not read its review cards", file=sys.stderr)
            continue
        graphs, running = board_view
        # A graph on the board for this head is in progress or done awaiting
        # publish: nothing to build, no slot. A failed or partial staging
        # leaves no synthesis card, so it is retried here.
        if head_sha[:8] in graphs:
            # The replacement graph demonstrably exists now (this check only
            # passes once review-workflow has actually created its
            # synthesis card for head_sha), so an older head's blocked
            # synthesis card is superseded and safe to archive -- unlike
            # right after creating the handoff card below, where no lens or
            # synthesis card for this head exists yet at all (review council,
            # three lenses: archiving there could delete the only resumable
            # graph before any replacement exists).
            stale = stale_blocked_synthesis(args.board, repo, number, head_sha)
            if stale:
                a = subprocess.run(hermes_argv("kanban", "--board", args.board, "archive", *stale),
                                   capture_output=True, text=True)
                if a.returncode == 0:
                    print(f"  archived superseded blocked review(s) for {repo}#{number}: {' '.join(stale)}")
                else:
                    print(f"  could not archive {' '.join(stale)}: {a.stderr.strip()[:200]}", file=sys.stderr)
            continue
        if running:
            print(f"  wait {repo}#{number}: a review is still running")
            continue
        # review_graphs() cannot see this: an intake that has not yet built
        # a synthesis card is invisible to it. A ready or running intake
        # already exists for this exact head -- review-workflow just has
        # not finished yet -- so re-attempting the handoff would spend
        # another admission slot on work that is already in flight, not
        # new (review council, three lenses, same defect twice: the first
        # fix only caught a blocked intake, not a healthy one still running).
        in_flight = intake_in_flight(args.board, repo, number, head_sha)
        if in_flight:
            print(f"  wait {repo}#{number}: its review-workflow handoff is already in flight")
            continue
        print(f"  {repo}#{number} @ {head_sha[:8]}")

        # Was this operation already staged by an earlier run? See the
        # module docstring's note on _staging_dir_exists/admitted.
        op_id = operation_id(repo, number, head_sha)
        already_staged = _staging_dir_exists(args.work_root / op_id)
        checkout = ensure_checkout(args.checkout_root, repo, number, base_sha, head_sha)
        if checkout is None:
            continue
        # In the work root (shared /workspaces mount), so the container-side
        # stager can read it.
        text_file = args.work_root / f".pr-text-{op_id}.md"
        text_file.write_text(pr_text(repo, number))
        extra = []
        for kind, content in (("checks", pr_checks(repo, number)),
                              ("threads", pr_threads(repo, number))):
            if content is not None:
                f = args.work_root / f".pr-{kind}-{op_id}"
                f.write_text(content)
                extra += [f"--{kind}", str(f)]

        # One card to review-workflow, not a build-review-graph subprocess
        # call: it stages the evidence itself, decides mode, and builds the
        # lens+synthesis graph (dd-workflow-director.md). This step only
        # hands off the inputs that script used to take as CLI flags.
        body_lines = [
            f"repo: {repo}", f"pr: {number}", f"base_sha: {base_sha}",
            f"head_sha: {head_sha}", f"checkout: {checkout}",
            f"work_root: {args.work_root}", f"board: {args.board}",
            f"pr_text: {text_file}",
        ]
        for i in range(0, len(extra), 2):
            body_lines.append(f"{extra[i].lstrip('-')}: {extra[i + 1]}")
        r = subprocess.run(
            hermes_argv("kanban", "--board", args.board, "create",
                       f"Review {repo}#{number} @ {head_sha[:8]}",
                       "--body", "\n".join(body_lines), "--assignee", "ralph-review-workflow",
                       "--idempotency-key", f"{op_id}-intake",
                       "--max-runtime", "480", "--max-retries", "3", "--json"),
            capture_output=True, text=True)
        if r.returncode != 0:
            print(r.stderr, file=sys.stderr)
            continue
        # A stable idempotency key means a second call for the same head
        # returns the SAME card id Hermes already has, whatever its current
        # status -- `create` succeeding (returncode 0) says nothing about
        # whether that card is making progress. A card review-workflow
        # exhausted its retries on, or a human blocked, is returned here
        # unchanged every pass: surfaced once per pass so it is not read as
        # a fresh admission, not retried automatically (unblocking a stuck
        # graph is the same human call as unblocking any other card), and
        # treated exactly like a failed handoff below -- no slot spent.
        # (Archiving an older head's stale synthesis card never happens
        # here regardless of status: this call only creates or finds the
        # INTAKE card, before review-workflow has had any chance to build a
        # single lens or synthesis card for this head. That only happens
        # above, once `head_sha[:8] in graphs` is true on some later pass.)
        try:
            handoff_id = json.loads(r.stdout).get("id")
        except (ValueError, AttributeError):
            handoff_id = None
        handoff_status = None
        if handoff_id:
            shown = subprocess.run(
                hermes_argv("kanban", "--board", args.board, "show", handoff_id, "--json"),
                capture_output=True, text=True)
            try:
                handoff_status = json.loads(shown.stdout)["task"]["status"]
            except (ValueError, KeyError, TypeError):
                handoff_status = None
        print(r.stdout, end="")
        if handoff_status == "blocked":
            print(f"  {handoff_id} ({repo}#{number} @ {head_sha[:8]}) is blocked, "
                 "not retried automatically", file=sys.stderr)
            continue
        # A slot is spent only by a graph actually built: a failed checkout
        # or build does not starve later PRs.
        slots += 1
        if not already_staged:
            admitted += 1

    if args.once_for_real:
        print(f"\nadmitted {admitted} new operation(s) this run")
    else:
        print(f"\n(dry run: pass --once-for-real to actually build these graphs)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
