#!/usr/bin/env python3
"""Discover open pull requests assigned to this account and build their review graphs.

PR 6 of the fleet-into-ralph design. The first thing in this whole design that
acts without a human present, and the only one that can spend money
unattended.

    bootstrap/discover-reviews --allow owner/repo [--allow owner/repo2] \
        --checkout-root /workspaces/repo-cache --work-root /workspaces/review-work

--allow-file <path> is an alternative to repeated --allow flags: a flat file
of owner/repo lines, read fresh on every invocation. bootstrap/cutover-repo
(PR 7) writes this file, so moving a repository's review scope into Ralph
takes effect on the next tick with no restart here. The two can be combined;
at least one is required, or this refuses rather than silently discovering
nothing from an empty scope.

Run on a timer (cron, a sidecar loop) once this has been watched manually for
a while. --once-for-real is required to let it call build-review-graph; every
other flag works without it, so a dry run of the discovery and filtering logic
alone never needs that acknowledgement.

NO DAILY CAP, BY DIRECT INSTRUCTION. Every assigned PR gets reviewed, not a
count held low on purpose. The lever against a real backlog flood is
concurrency: kanban.max_in_progress bounds how many cards run at once
regardless of how many are queued, so a flood drains over hours rather than
minutes, which still gives a human time to notice and stop a genuine runaway
without throttling healthy throughput at an arbitrary number.

Two bounds remain, each enforced here rather than left to the caller's
judgement:

  --max-per-run (default 10)   caps how many PRs one invocation can admit,
                                regardless of how many gh search prs returns
  --max-age-days (default 7)   gh search prs' own --updated filter; a PR that
                                has not moved in a week was not assigned
                                yesterday, so discovering it today is not
                                urgent and widens the backlog a cold start
                                could import
  --allow (repeatable)         an explicit allowlist: owner/repo, or
                                owner/* for every repo of one owner (how
                                bootstrap/cutover-repo moves a whole owner
                                grant). No "all accessible repos" mode
                                exists -- the fleet's board-engine shape,
                                with no per-repo dial, is the design's
                                rejected alternative (section 4)

A PR already admitted is a no-op. This is checked here, not inferred from
build-review-graph's output: it gives no new-vs-existing signal, since every
card line looks the same whether created or deduplicated by its own
idempotency key. Instead this checks whether the operation's staging
directory already existed before this run touched it -- the one thing that
is new exactly once.
"""
import argparse
import datetime
import json
import os
import pathlib
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent

sys.path.insert(0, str(HERE))
from importlib.machinery import SourceFileLoader
_stage = SourceFileLoader("stage_review_evidence", str(HERE / "stage-review-evidence")).load_module()
operation_id = _stage.operation_id


def hermes_argv(*args):
    """Same bridge as bootstrap/publish-review and notifier/poller.py, and the
    same HERMES_HOME bug fixed there: forward it only when the caller has it
    set, never blank out a value the target container already has."""
    container = os.environ.get("RALPH_HERMES_CONTAINER")
    if container:
        home = os.environ.get("HERMES_HOME")
        extra = ["-e", f"HERMES_HOME={home}"] if home else []
        return ["docker", "exec", *extra, container, "hermes", *args]
    return ["hermes", *args]


def gh(*args) -> subprocess.CompletedProcess:
    return subprocess.run(["gh", *args], capture_output=True, text=True, timeout=90)


def search_assigned_prs(max_age_days: int) -> list[dict] | None:
    """None means the search itself failed; [] means it succeeded and found
    nothing. Found by the review council: both used to return [], so a gh
    auth failure or a network outage under a cron-driven run looked
    identical to "no PRs assigned today" and main() always exited 0 either
    way -- a scheduled run silently stops discovering anything and nothing
    says so."""
    cutoff = (datetime.datetime.now(datetime.timezone.utc)
             - datetime.timedelta(days=max_age_days)).strftime("%Y-%m-%d")
    args = ["search", "prs", "--assignee", "@me", "--state", "open",
           "--json", "number,title,url,repository,updatedAt", "--limit", "1000",
           "--updated", f">={cutoff}"]
    r = gh(*args)
    if r.returncode != 0:
        print(f"error: gh search prs failed: {r.stderr.strip()[:300]}", file=sys.stderr)
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        print(f"error: gh search prs returned unparseable output", file=sys.stderr)
        return None


def pr_shas(repo: str, number: int) -> tuple[str, str] | None:
    r = gh("pr", "view", str(number), "-R", repo, "--json", "baseRefOid,headRefOid")
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
        return data["baseRefOid"], data["headRefOid"]
    except (json.JSONDecodeError, KeyError):
        return None


def ensure_checkout(root: pathlib.Path, repo: str, number: int, base_sha: str,
                    head_sha: str) -> pathlib.Path | None:
    """One cached clone per repository under root, fetched on demand.

    Cloned without a working tree -- stage-review-evidence only needs the
    two commits to diff, never a checked-out file. --checkout-root must be
    the same path inside the hermes container, where build-review-graph
    reads it (the compose stack mounts ./workspaces at /workspaces in both).
    """
    path = root / repo
    if not (path / ".git").exists() and not (path / "HEAD").exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        r = gh("repo", "clone", repo, str(path), "--", "--no-checkout", "--filter=blob:none")
        if r.returncode != 0:
            print(f"  skip {repo}#{number}: clone failed: {r.stderr.strip()[:200]}", file=sys.stderr)
            return None
    r = subprocess.run(["git", "-C", str(path), "fetch", "--quiet", "origin",
                        base_sha, f"+refs/pull/{number}/head:refs/remotes/pr/{number}"],
                       capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        print(f"  skip {repo}#{number}: fetch failed: {r.stderr.strip()[:200]}", file=sys.stderr)
        return None
    return path


def _staging_dir_exists(path: pathlib.Path) -> bool:
    """Checks the filesystem build-review-graph actually staged into, not
    this process's own.

    build-review-graph runs inside the hermes container when
    RALPH_HERMES_CONTAINER is set (its Kanban workspace paths only resolve
    there), so a prior run's staging directory lives on the container's
    filesystem, not the host's -- this script itself runs wherever gh lives,
    which is the host. --work-root is the same path string on both sides by
    convention, but the same string is two different directories. Checking
    path.is_dir() here, on the host, against a directory the container
    created was always False: 'already staged' never fired.
    """
    container = os.environ.get("RALPH_HERMES_CONTAINER")
    if not container:
        return path.is_dir()
    r = subprocess.run(["docker", "exec", container, "test", "-d", str(path)],
                       capture_output=True, timeout=30)
    return r.returncode == 0


def _positive_int(value: str) -> int:
    """Every bound in this script is a ceiling, and a nonpositive one is not
    a smaller ceiling, it is a hole: allowed[:budget] with a negative budget
    admits almost the entire eligible list instead of enforcing one."""
    n = int(value)
    if n <= 0:
        raise argparse.ArgumentTypeError(f"must be a positive integer, got {value!r}")
    return n


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--allow", action="append", default=[], dest="allowlist",
                    metavar="owner/repo",
                    help="repeatable; a PR outside this list is never admitted, "
                         "no matter what gh search prs returns")
    ap.add_argument("--allow-file", type=pathlib.Path,
                    help="a flat file of owner/repo lines, one per line, read "
                         "fresh on every invocation -- not cached, not read once "
                         "at process start. bootstrap/cutover-repo writes this "
                         "file, so a cutover takes effect on the next tick with "
                         "no restart, the same way the fleet's own authority "
                         "file is re-read on its own schedule. Merged with "
                         "--allow if both are given.")
    ap.add_argument("--checkout-root", required=True, type=pathlib.Path,
                    help="directory holding one cached clone per repository, "
                         "created and fetched on demand; must be the same path "
                         "inside the hermes container")
    ap.add_argument("--work-root", required=True, type=pathlib.Path)
    ap.add_argument("--board", default="queues")
    ap.add_argument("--max-per-run", type=_positive_int, default=10)
    ap.add_argument("--max-age-days", type=_positive_int, default=7)
    ap.add_argument("--once-for-real", action="store_true",
                    help="required to actually call build-review-graph; without it, "
                         "this reports what it would admit and exits 0")
    args = ap.parse_args()

    allowlist = list(args.allowlist)
    if args.allow_file is not None:
        if args.allow_file.is_file():
            allowlist += [line.strip() for line in args.allow_file.read_text().splitlines()
                         if line.strip() and not line.strip().startswith("#")]
        # A missing allow-file is not an error: bootstrap/cutover-repo may not
        # have run yet, and an empty allowlist already fails closed below --
        # admitting nothing is the safe default, not a crash.
    args.allowlist = sorted(set(allowlist))
    if not args.allowlist:
        print("error: no repos in scope (--allow and --allow-file both empty); "
             "nothing to discover", file=sys.stderr)
        return 2

    args.work_root.mkdir(parents=True, exist_ok=True)

    prs = search_assigned_prs(args.max_age_days)
    if prs is None:
        # A failed search and "nothing assigned today" must not look the
        # same to a scheduler: exit non-zero so a cron wrapper notices
        # and alerts, rather than silently discovering nothing forever.
        print("error: gh search prs failed; discovering nothing this run",
             file=sys.stderr)
        return 1
    print(f"gh search found {len(prs)} open assigned PR(s) within "
         f"{args.max_age_days} day age filter")

    allowed, skipped_not_allowed = [], 0
    for pr in prs:
        repo = pr.get("repository", {}).get("nameWithOwner", "")
        if repo in args.allowlist or f"{repo.split('/')[0]}/*" in args.allowlist:
            allowed.append(pr)
        else:
            skipped_not_allowed += 1
    print(f"  {len(allowed)} in the allowlist, {skipped_not_allowed} skipped "
         f"(not in --allow)")

    to_admit = allowed[:args.max_per_run]
    if len(allowed) > args.max_per_run:
        print(f"  admitting up to {args.max_per_run} of {len(allowed)} eligible "
             f"(per-run cap {args.max_per_run})")

    admitted = 0
    for pr in to_admit:
        repo = pr["repository"]["nameWithOwner"]
        number = pr["number"]
        shas = pr_shas(repo, number)
        if shas is None:
            print(f"  skip {repo}#{number}: could not read base/head SHAs", file=sys.stderr)
            continue
        base_sha, head_sha = shas
        print(f"  {repo}#{number} @ {head_sha[:8]}")
        if not args.once_for_real:
            continue

        # Was this operation already staged by an earlier run?
        # build-review-graph gives no new-vs-existing signal in its own
        # output -- every card line looks the same whether created or
        # deduplicated by its idempotency key -- so this checks the one
        # thing that is new exactly once: the staging directory
        # stage-review-evidence creates for an operation id it has not
        # seen before.
        op_id = operation_id(repo, number, head_sha)
        already_staged = _staging_dir_exists(args.work_root / op_id)
        checkout = ensure_checkout(args.checkout_root, repo, number, base_sha, head_sha)
        if checkout is None:
            continue

        container = os.environ.get("RALPH_HERMES_CONTAINER")
        graph_cmd = (["docker", "exec", container, "python3",
                     "/ralph/bootstrap/build-review-graph"] if container
                    else [sys.executable, str(HERE / "build-review-graph")])
        r = subprocess.run(
            [*graph_cmd, "--once",
             "--repo", repo, "--pr", str(number),
             "--base-sha", base_sha, "--head-sha", head_sha,
             "--checkout", str(checkout), "--work-root", str(args.work_root),
             "--board", args.board],
            capture_output=True, text=True)
        print(r.stdout, end="")
        if r.returncode != 0:
            print(r.stderr, file=sys.stderr)
            continue
        if not already_staged:
            admitted += 1

    if args.once_for_real:
        print(f"\nadmitted {admitted} new operation(s) this run")
    else:
        print(f"\n(dry run: pass --once-for-real to actually build these graphs)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
