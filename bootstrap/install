#!/usr/bin/env bash
# Bring a fresh Ralph install up to the state the repo describes: profiles,
# a board, and the settings the two-gate model depends on.
#
# Idempotent by design. Running it again on an existing install updates
# profile definitions and leaves everything else alone.

set -euo pipefail

PROFILES_DIR=${RALPH_PROFILES_DIR:-/ralph/profiles}
BOARD=${RALPH_BOARD:-ralph}
[ -f "$PROFILES_DIR/PRINCIPLES.md" ] || { echo "missing Ralph principles" >&2; exit 1; }
[ -f "$PROFILES_DIR/STANDARDS.md" ] || { echo "missing Ralph engineering standards" >&2; exit 1; }

# The hermes CLI lives in the hermes image, which costs 4.5GB. Rather than
# carry it to run a dozen setup commands, run them in the hermes container.
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    hermes() { docker exec -e "HERMES_HOME=${HERMES_HOME:-}" "$RALPH_HERMES_CONTAINER" hermes "$@"; }
fi

echo "ralph: installing into ${HERMES_HOME:-$HOME/.hermes}"

# A human gate is a blocked card, and blocked cards are never auto-dispatched.
# Review dispatch stays on so the agent reviewer pass still runs; what matters
# is that request-review always names a reviewer, which the author profile does.
hermes config set kanban.review_dispatch true >/dev/null

# Unset, these fall back to a host-memory-derived default --
# clamp(MemTotal / 512MiB, 2, 8) -- which is silent and changes with the
# machine's RAM rather than with a decision anyone made. So they are set,
# per instance: max_in_progress counts one instance's boards only, so two
# instances on one VM add up. 2 per profile keeps a queue flood from
# starving a hand-written card, and keeps the maintainer, the one profile
# that builds and tests, to 2 at once.
# Dispatcher settings are read once at gateway boot, so this takes a
# restart to apply, not a reload.
hermes config set kanban.max_in_progress "${RALPH_MAX_IN_PROGRESS:-6}" >/dev/null
hermes config set kanban.max_in_progress_per_profile 2 >/dev/null

# A card-dispatched worker runs with nobody present to answer an approval
# prompt, and Hermes' default is to refuse the approval-gated tools outright.
# That makes work on the board strictly weaker than the same work run
# interactively, which is backwards: the sandbox is the boundary, not a
# prompt. Smart approval still refuses what it judges genuinely dangerous,
# and everything a worker runs happens in a container that cannot reach the
# host, the board, or another profile's credentials.
hermes config set approvals.single_query_mode approve >/dev/null
hermes config set approvals.unattended_mode approve >/dev/null

# hermes-webui stages the agent's source by rsync-ing it as an unprivileged
# user, and the Hermes image ships one file in that tree, an empty lock file,
# readable by root alone. rsync fails on it and hermes-webui exits before it
# serves anything. Making that one file world-readable is enough; it holds no
# data.
#
# Named exactly, not found by permission. A sweep over everything unreadable
# would also widen any private file a future image happens to ship there,
# which could be a key rather than a lock, and nothing would say so. If this
# file stops existing, or another one starts breaking the staging, that should
# be noticed and decided, not silently absorbed.
#
# Not tolerant of failure either: hermes-webui waits on this script finishing
# successfully, so swallowing an error here would let it start against a tree
# that still breaks its staging, which is the failure this closes.
AGENT_LOCK=/opt/hermes/tools/.install.lock
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    if docker exec "$RALPH_HERMES_CONTAINER" test -e "$AGENT_LOCK"; then
        docker exec -u 0 "$RALPH_HERMES_CONTAINER" chmod o+r "$AGENT_LOCK"
        echo "  made $AGENT_LOCK readable for hermes-webui's staging"
    fi
fi

# The orchestrator plans the card graph; Kanban must not plan a second one.
# With auto_decompose on, a card that is already finished and waiting on a
# human gets split into subtasks that redo the work it just did, and the
# human's feedback is lost behind a decomposition notice.
hermes config set kanban.auto_decompose false >/dev/null

# Where agent commands run. Set globally and again in every profile below: a
# board-dispatched worker builds its terminal from its own profile's config
# alone, ignoring both the container's TERMINAL_ENV and the global config, and
# without this falls back to Hermes' `local` backend -- the hermes container
# itself, next to every credential and the board, with no gh.
# $1 is empty for the global config or `-p <profile>`; $2 is that config's home.
#
# Each instance gets its own sandbox root, RALPH_SANDBOX_ROOT: an absolute host
# path that compose mounts into hermes and hermes-webui at the same path.
# Hermes creates a sandbox dir there and asks the daemon to bind it; the daemon
# resolves the path on the host, so both sides see one directory (#97). A
# per-instance root also keeps personal and work sandboxes apart (#77).
: "${RALPH_SANDBOX_ROOT:?set RALPH_SANDBOX_ROOT to an absolute host path}"
# Where hermes-webui stores chat uploads (HERMES_WEBUI_ATTACHMENT_DIR, #128).
# Created through the hermes container, which mounts the sandbox root (init
# does not), so the bind source exists before a sandbox mounts it.
ATTACH_DIR="$RALPH_SANDBOX_ROOT/.webui-attachments"
[ -z "${RALPH_HERMES_CONTAINER:-}" ] \
    || docker exec -u hermes "$RALPH_HERMES_CONTAINER" mkdir -p "$ATTACH_DIR" || true
sandbox_config() {
    hermes $1 config set terminal.sandbox_dir "$RALPH_SANDBOX_ROOT/$2" >/dev/null
    # Ralph's image adds git and gh to the stock sandbox and nothing else;
    # every tool in there is reachable by untrusted code.
    hermes $1 config set terminal.backend docker >/dev/null
    hermes $1 config set terminal.docker_image "${RALPH_SANDBOX_IMAGE:-ghcr.io/zhachory1/ralph-sandbox:dev}" >/dev/null
    # Credentials the sandbox needs for repository work. Nothing else is
    # forwarded: the model key and the chat webhook stay outside it.
    hermes $1 config set terminal.docker_forward_env '["GH_TOKEN","GITHUB_TOKEN","GIT_AUTHOR_NAME","GIT_AUTHOR_EMAIL","GIT_COMMITTER_NAME","GIT_COMMITTER_EMAIL","BUF_TOKEN","BUILDKITE_API_TOKEN","RALPH_DOCS_REPO","RALPH_DOCS_PUBLIC"]' >/dev/null
    # One sandbox's ceiling. A maintenance build of a large repository peaks at
    # several GB; at Hermes' default of 5 GB, three at once overrun a 12 GB VM.
    hermes $1 config set terminal.container_memory "${RALPH_SANDBOX_MEMORY_MB:-3072}" >/dev/null
    # The default profile (the WebUI chat) browses the repo cache read-only,
    # like the researcher (owner decision 2026-11-05), and reads chat uploads
    # read-only at the path hermes-webui hands it (#128). Uploads are the
    # default profile's alone: no other profile's sandbox mounts them.
    local vols="\"$ATTACH_DIR:$ATTACH_DIR:ro\""
    [ -z "$REPO_CACHE_SRC" ] || vols="\"$REPO_CACHE_SRC:/repo-cache:ro\",$vols"
    hermes $1 config set terminal.docker_volumes "[$vols]" >/dev/null
}
# Profiles that see /repo-cache: the three that clone through it, and the
# researcher, which browses it read-only (owner decision 2026-11-05; the
# default profile gets it in sandbox_config). Every other profile -- the
# lenses, synthesis, chat-maintainer, orchestrator -- reads through gh only
# and must not see the cache, which spans every repository this instance has
# touched (#79 review).
repo_cache_profile() {
    case "$1" in
        builder|maintainer|author|researcher) return 0 ;;
        *) return 1 ;;
    esac
}
# Profiles that search the knowledge index (#121): the general ones. The lenses,
# review-synthesis, chat-maintainer, chat-summarizer and inbox-drafter reason
# only from their staged evidence or have no tools by design, so never get it.
knowledge_profile() {
    case "$1" in
        orchestrator|author|builder|maintainer|researcher|reviewer|analyst|experimenter|auditor|watcher) return 0 ;;
        *) return 1 ;;
    esac
}
# The knowledge server as an mcp_servers block, appended after a profile's own
# config; write-profile-config folds it in beside lens-tools. Only when the
# knowledge service exists (COMPOSE_PROFILES is the switch).
knowledge_block() {
    [ -n "$KNOWLEDGE_ON" ] || return 0
    cat <<'YAML'
mcp_servers:
  knowledge:
    url: "http://knowledge:8181/mcp"
    enabled: true
    tools:
      include: [query, get, multi_get, status]
YAML
}
# MCP servers the private overlay grants a profile (#133), as an mcp_servers
# block that write-profile-config folds in beside the others. Profile configs
# are rewritten whole, so a server removed from mcp.json goes on the next run.
OVERLAY_MCP=""
[ -f /ralph/private-mcp/mcp.json ] && OVERLAY_MCP=/ralph/private-mcp/mcp.json
overlay_mcp_block() {
    [ -n "$OVERLAY_MCP" ] || return 0
    python3 "$(dirname "$0")/write-profile-config.py" --overlay-block "$OVERLAY_MCP" "$1"
}
KNOWLEDGE_ON=""
# Running, not merely present: a stopped leftover after the profile is
# dropped must not count (#123 review).
if [ -n "${RALPH_KNOWLEDGE_CONTAINER:-}" ] \
        && [ "$(docker inspect -f '{{.State.Running}}' "$RALPH_KNOWLEDGE_CONTAINER" 2>/dev/null)" = true ]; then
    KNOWLEDGE_ON=1
fi
# The same settings as sandbox_config, as the profile's whole terminal block,
# so write-profile-config writes them with the rest of the profile in one go.
terminal_block() {
    echo "terminal:"
    echo "  backend: docker"
    echo "  docker_image: ${RALPH_SANDBOX_IMAGE:-ghcr.io/zhachory1/ralph-sandbox:dev}"
    echo "  docker_forward_env: [GH_TOKEN, GITHUB_TOKEN, GIT_AUTHOR_NAME, GIT_AUTHOR_EMAIL, GIT_COMMITTER_NAME, GIT_COMMITTER_EMAIL, BUF_TOKEN, BUILDKITE_API_TOKEN, RALPH_DOCS_REPO, RALPH_DOCS_PUBLIC]"
    echo "  container_memory: ${RALPH_SANDBOX_MEMORY_MB:-3072}"
    echo "  sandbox_dir: $RALPH_SANDBOX_ROOT/ralph-$2"
    # The instance's repository cache, so a card borrows its objects (git
    # clone --reference) instead of downloading a large repository again.
    # Read-only: a sandbox runs untrusted code and must not corrupt what other
    # cards borrow from. Clone profiles only: the cache holds every repository
    # this instance has touched, across every org (#79 review). Writing the
    # whole block also drops the mount from a profile that no longer gets it.
    if [ -n "$REPO_CACHE_SRC" ] && repo_cache_profile "$2"; then
        echo "  docker_volumes: [\"$REPO_CACHE_SRC:/repo-cache:ro\"]"
    fi
    # Review and chat cards point at staged evidence under /workspaces in the
    # hermes container. The profiles that read it do so from their sandbox,
    # so it is mounted there at the same path, read-only.
    [ -n "$WORKSPACES_SRC" ] || return 0
    case "$2" in
        lens-*|review-synthesis)
            echo "  docker_volumes: [\"$WORKSPACES_SRC/review-work:/workspaces/review-work:ro\"]" ;;
        chat-maintainer)
            echo "  docker_volumes: [\"$WORKSPACES_SRC/chat-inbox:/workspaces/chat-inbox:ro\"]" ;;
    esac
}
# The daemon resolves a bind source on the VM, so the cache is named by the
# host path behind this instance's /workspaces, never by a path in a container.
REPO_CACHE_SRC=""
WORKSPACES_SRC=""
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    ws=$(docker inspect "$RALPH_HERMES_CONTAINER" \
        --format '{{range .Mounts}}{{if eq .Destination "/workspaces"}}{{.Source}}{{end}}{{end}}')
    if [ -n "$ws" ]; then
        WORKSPACES_SRC="$ws"
        REPO_CACHE_SRC="$ws/repo-cache"
        docker exec -u hermes "$RALPH_HERMES_CONTAINER" mkdir -p /workspaces/repo-cache
    fi
fi
sandbox_config "" default
# The default profile is the WebUI chat. It plans and hands off work like the
# orchestrator, so it gets the board (#105); Hermes ships it disabled.
hermes tools enable kanban >/dev/null
# hermes-webui runs profiles in-process and its image has no docker client;
# give it the hermes image's own, in the shared volume (HERMES_DOCKER_BINARY).
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    docker exec -u hermes "$RALPH_HERMES_CONTAINER" sh -c \
        'mkdir -p "$HERMES_HOME/bin" && cp /usr/bin/docker "$HERMES_HOME/bin/docker"'
fi

# The review lenses (PR 2 of the fleet-into-ralph design) run on an OpenAI
# credential Ralph's other nine profiles never touch -- those stay on
# Anthropic. An API key is used rather than the fleet's device-code OAuth
# flow because it is scriptable here and does not expire mid-stack-restart.
# Optional: a host with no review queue running yet has no RALPH_OPENAI_API_KEY
# and this step is skipped, same as any other profile that is not installed.
if [ -n "${RALPH_OPENAI_API_KEY:-}" ]; then
    if ! hermes auth list 2>/dev/null | grep -q "^openai-api"; then
        hermes auth add openai-api --type api-key --api-key "$RALPH_OPENAI_API_KEY" --label ralph-review-lenses >/dev/null
        echo "  added openai-api credential for the review lenses"
    else
        echo "  openai-api credential already present"
    fi
fi

# The author, builder and maintainer push as the PR author, not as the reviewer:
# maintain-pr ignores feedback from its own login. Profile-scoped GH_TOKEN
# overrides the stack-wide review token and is forwarded into their sandboxes.
if [ -n "${RALPH_MAINTAIN_TOKEN:-}" ]; then
    # The token travels as an env var to the exec, never on a command line.
    docker exec -i -u hermes -e RALPH_MAINTAIN_TOKEN -e "RALPH_MAINTAIN_LOGIN=${RALPH_MAINTAIN_LOGIN:-}" \
        "${RALPH_HERMES_CONTAINER:-ralph-hermes-1}" sh -eu -c '
        for profile in ralph-maintainer ralph-builder ralph-author; do
            f="${HERMES_HOME:-$HOME/.hermes}/profiles/$profile/.env"
            [ -f "$f" ] || continue
            tmp=$(mktemp "$f.XXXXXX")
            grep -vE "^(GH_TOKEN|GIT_(AUTHOR|COMMITTER)_(NAME|EMAIL))=" "$f" > "$tmp" || true
            printf "GH_TOKEN=%s\n" "$RALPH_MAINTAIN_TOKEN" >> "$tmp"
            if [ -n "$RALPH_MAINTAIN_LOGIN" ]; then
                for k in AUTHOR COMMITTER; do
                    printf "GIT_%s_NAME=%s\nGIT_%s_EMAIL=%s@users.noreply.github.com\n" \
                        "$k" "$RALPH_MAINTAIN_LOGIN" "$k" "$RALPH_MAINTAIN_LOGIN" >> "$tmp"
                done
            fi
            chmod 600 "$tmp" && mv "$tmp" "$f"
        done'
    echo "  author, builder and maintainer push with RALPH_MAINTAIN_TOKEN"
fi

# Agent-instruction files (AGENTS.md, CLAUDE.md, ...) need a human's
# approval per write, and a card run has no human: the edit is refused even
# when a reviewer asked for it (op3#17752). Opt-in per instance; on, the
# file is guarded by review like any other.
if [ "${RALPH_ALLOW_AGENT_FILE_EDITS:-}" = "1" ]; then
    hermes config set security.protected_instruction_files false >/dev/null
else
    hermes config set security.protected_instruction_files true >/dev/null
fi

hermes kanban init >/dev/null 2>&1 || true
if ! hermes kanban boards list 2>/dev/null | grep -qE "^[● ]+${BOARD}\b"; then
    hermes kanban boards create "$BOARD" \
        --name "Ralph" \
        --description "Feature pipeline: PRD, design docs, PRs" \
        --default-workdir /workspaces >/dev/null
    echo "  created board ${BOARD}"
else
    echo "  board ${BOARD} already exists"
fi

# A second board for anything a producer creates automatically, never for
# anything you write by hand. The embedded dispatcher enumerates every
# board each tick with no extra config, so this needs no dispatcher
# wiring; max_in_progress above is a host cap shared across every board,
# so a second board cannot multiply concurrency. The notifier polls only
# RALPH_BOARD, so queue cards stay off its radar by construction: a flood
# of machine-created cards cannot page you, with nothing left to maintain
# that property.
QUEUES_BOARD=${RALPH_QUEUES_BOARD:-queues}
if ! hermes kanban boards list 2>/dev/null | grep -qE "^[● ]+${QUEUES_BOARD}\b"; then
    hermes kanban boards create "$QUEUES_BOARD" \
        --name "Ralph queues" \
        --description "Producer-created work: PR review, maintenance, inbox. No human cards here." \
        --default-workdir /workspaces >/dev/null
    echo "  created board ${QUEUES_BOARD}"
else
    echo "  board ${QUEUES_BOARD} already exists"
fi

# Listed once: each hermes call is a docker exec, and this loop runs per profile.
PROFILE_LIST=$(hermes profile list 2>/dev/null || true)
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    docker cp /ralph/bootstrap/write-profile-config.py "$RALPH_HERMES_CONTAINER:/tmp/wmc.py"
fi
SRC_TMP=$(mktemp)
for dir in "$PROFILES_DIR"/*/; do
    [ -d "$dir" ] || continue
    base="$(basename "$dir")"
    name="ralph-$base"

    if ! printf '%s\n' "$PROFILE_LIST" | grep -q "\b${name}\b"; then
        hermes profile create "$name" --description "Ralph $(basename "$dir")" >/dev/null
        echo "  created profile ${name}"
    else
        echo "  updating profile ${name}"
    fi

    target="${HERMES_HOME:-$HOME/.hermes}/profiles/${name}"
    if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
        if [ -f "$dir/SOUL.md" ]; then
            { cat "$PROFILES_DIR/PRINCIPLES.md"; printf '\n'; cat "$PROFILES_DIR/STANDARDS.md"; printf '\n'; cat "$dir/SOUL.md"; } |
                docker exec -i "$RALPH_HERMES_CONTAINER" sh -c 'cat > "$1"' sh "$target/SOUL.md"
        fi
        { cat "$dir/config.yaml" 2>/dev/null || true; terminal_block "$target" "$base"
          knowledge_profile "$base" && knowledge_block; overlay_mcp_block "$base"; } > "$SRC_TMP"
        docker cp "$SRC_TMP" "$RALPH_HERMES_CONTAINER:/tmp/src.yaml"
        docker exec "$RALPH_HERMES_CONTAINER" python3 /tmp/wmc.py /tmp/src.yaml "$target/config.yaml"
        continue
    fi
    if [ -f "$dir/SOUL.md" ]; then
        { cat "$PROFILES_DIR/PRINCIPLES.md"; printf '\n'; cat "$PROFILES_DIR/STANDARDS.md"; printf '\n'; cat "$dir/SOUL.md"; } > "$target/SOUL.md"
    fi

    # The model and the toolsets are ours; the rest is Hermes-generated.
    { cat "$dir/config.yaml" 2>/dev/null || true; terminal_block "$target" "$base"
          knowledge_profile "$base" && knowledge_block; overlay_mcp_block "$base"; } > "$SRC_TMP"
    python3 /ralph/bootstrap/write-profile-config.py "$SRC_TMP" "$target/config.yaml"
done
# The default profile's SOUL (the WebUI chat) is the global one, built like
# every profile's: PRINCIPLES + STANDARDS + its own text (#128). Its own text
# lives beside PRINCIPLES, not in profiles/<name>/, which would create a
# separate ralph-default profile.
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    { cat "$PROFILES_DIR/PRINCIPLES.md"; printf '\n'; cat "$PROFILES_DIR/STANDARDS.md"; printf '\n'; cat "$PROFILES_DIR/DEFAULT_SOUL.md"; } |
        docker exec -i "$RALPH_HERMES_CONTAINER" sh -c 'cat > "$1"' sh "${HERMES_HOME:-$HOME/.hermes}/SOUL.md"
fi
# The default profile (the WebUI chat) searches too. Its config is the global
# one, which may hold servers the owner added: add or remove only the
# `knowledge` entry, leaving every other server as it is (#123 review).
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    docker exec "$RALPH_HERMES_CONTAINER" python3 /tmp/wmc.py --knowledge "${KNOWLEDGE_ON:+on}" \
        "${HERMES_HOME:-$HOME/.hermes}/config.yaml"
fi
# The default profile's overlay servers. Its config is the global one, which
# may hold servers the owner added, so only the overlay's own entries change:
# the ones written last time (recorded beside the config) are dropped, then
# mcp.json's current grant is added.
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    gcfg="${HERMES_HOME:-$HOME/.hermes}/config.yaml"
    state="${HERMES_HOME:-$HOME/.hermes}/.ralph-overlay-mcp"
    prev=$(docker exec "$RALPH_HERMES_CONTAINER" sh -c 'cat "$1" 2>/dev/null || true' sh "$state")
    now=""
    if [ -n "$OVERLAY_MCP" ]; then
        docker cp "$OVERLAY_MCP" "$RALPH_HERMES_CONTAINER:/tmp/overlay-mcp.json"
        now=$(python3 -c 'import json,sys; print(",".join(n for n,s in json.load(open(sys.argv[1])).items() if "default" in s.get("profiles",[])))' "$OVERLAY_MCP")
    fi
    # Record the union first: if the config write below is interrupted, the
    # next run still knows every name it may have written (#134 review).
    all=$(printf '%s,%s' "$prev" "$now" | tr ',' '\n' | grep -v '^$' | sort -u | paste -sd, -)
    printf '%s' "$all" | docker exec -i "$RALPH_HERMES_CONTAINER" sh -c 'cat > "$1"' sh "$state"
    docker exec "$RALPH_HERMES_CONTAINER" python3 /tmp/wmc.py --overlay-global \
        "${OVERLAY_MCP:+/tmp/overlay-mcp.json}" "$all" "$gcfg"
    printf '%s' "$now" | docker exec -i "$RALPH_HERMES_CONTAINER" sh -c 'cat > "$1"' sh "$state"
    [ -z "$now$prev" ] || echo "  overlay MCP servers for default: ${now:-none}"
fi
rm -f "$SRC_TMP"

# CI logs for the profiles that fix failing builds. Runs after the profiles
# are created, so a fresh install gets it too (#107 review). Only the maintainer and
# builder get it, in their own .env, so it reaches only their sandboxes
# (forwarded by name above; a profile without it forwards nothing). Unset:
# removed, so turning it off takes effect.
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    docker exec -i -u hermes -e RALPH_BUILDKITE_TOKEN "$RALPH_HERMES_CONTAINER" sh -eu -c '
        for profile in ralph-maintainer ralph-builder; do
            f="${HERMES_HOME:-$HOME/.hermes}/profiles/$profile/.env"
            [ -d "$(dirname "$f")" ] || continue
            [ -f "$f" ] || { : > "$f"; chmod 600 "$f"; }
            tmp=$(mktemp "$f.XXXXXX")
            rc=0; grep -v "^BUILDKITE_API_TOKEN=" "$f" > "$tmp" || rc=$?
            [ "$rc" -le 1 ] || { rm -f "$tmp"; echo "cannot read $f" >&2; exit 1; }
            [ -z "${RALPH_BUILDKITE_TOKEN:-}" ] || printf "BUILDKITE_API_TOKEN=%s\n" "$RALPH_BUILDKITE_TOKEN" >> "$tmp"
            chmod 600 "$tmp" && mv "$tmp" "$f"
        done'
fi

# A dispatched worker sees its own profile's .env, not the container's, so a
# profile with no GH_TOKEN there has no repository access from a card
# (docs/decisions/0001). Every other profile reads with
# RALPH_PROFILE_READ_TOKEN: the stack's review token by default, or the
# owner's token where an instance sets it (decision 0002), so Ralph can read
# private repositories the owner was invited to. The author, builder and
# maintainer keep the push token written above. The default profile (the
# top-level .env) gets it too. Rewritten every install, so
# changing the setting takes effect.
# Exported and passed by name only (-e READ_TOKEN), never as -e NAME=value,
# so the token never appears in a process's command line.
export READ_TOKEN=${RALPH_PROFILE_READ_TOKEN:-${RALPH_GITHUB_TOKEN:-}}
if [ -n "$READ_TOKEN" ] && [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    docker exec -i -u hermes -e READ_TOKEN "$RALPH_HERMES_CONTAINER" sh -eu -c '
        # The top-level .env is the `default` profile, which the WebUI chat
        # uses unless a Ralph profile is picked; it reads like the others.
        for f in "${HERMES_HOME:-$HOME/.hermes}"/.env "${HERMES_HOME:-$HOME/.hermes}"/profiles/ralph-*/.env; do
            case "$f" in */ralph-maintainer/*|*/ralph-builder/*|*/ralph-author/*) continue ;; esac
            [ -f "$f" ] || continue
            tmp=$(mktemp "$f.XXXXXX")
            rc=0
            grep -v "^GH_TOKEN=" "$f" > "$tmp" || rc=$?
            # grep exits 1 when GH_TOKEN= is simply absent (normal, nothing to
            # strip); exit >=2 means it could not read $f, so $tmp may be
            # truncated. Do not let that overwrite the real file and lose its
            # other settings.
            if [ "$rc" -ge 2 ]; then
                rm -f "$tmp"
                echo "  warning: could not read $f (grep exit $rc); leaving it unchanged" >&2
                continue
            fi
            printf "GH_TOKEN=%s\n" "$READ_TOKEN" >> "$tmp"
            chmod 600 "$tmp" && mv "$tmp" "$f"
        done'
    echo "  every other profile reads with RALPH_PROFILE_READ_TOKEN"
fi

# Where agents write memories (#121, dd-ralph-knowledge D6): every profile and
# the default get the docs repository and whether it is public, which the
# public-safety rule in PRINCIPLES keys on. Neither is a secret. Visibility comes
# from GitHub; if it cannot be read, the instance counts as public (the safe
# side). Rewritten every install; unset RALPH_DOCS_REPO removes both.
if [ -n "${RALPH_HERMES_CONTAINER:-}" ]; then
    DOCS_PUBLIC=""
    if [ -n "${RALPH_DOCS_REPO:-}" ]; then
        vis=$(GH_TOKEN=$READ_TOKEN gh repo view "$RALPH_DOCS_REPO" --json visibility -q .visibility 2>/dev/null || true)
        DOCS_PUBLIC=1; [ "$vis" = PRIVATE ] || [ "$vis" = INTERNAL ] && DOCS_PUBLIC=0
        echo "  docs repository: ${vis:-visibility unknown}, RALPH_DOCS_PUBLIC=$DOCS_PUBLIC"
    fi
    docker exec -i -u hermes -e "DOCS_REPO=${RALPH_DOCS_REPO:-}" -e "DOCS_PUBLIC=$DOCS_PUBLIC" "$RALPH_HERMES_CONTAINER" sh -eu -c '
        for f in "${HERMES_HOME:-$HOME/.hermes}"/.env "${HERMES_HOME:-$HOME/.hermes}"/profiles/ralph-*/.env; do
            [ -f "$f" ] || continue
            tmp=$(mktemp "$f.XXXXXX")
            rc=0; grep -vE "^RALPH_DOCS_(REPO|PUBLIC)=" "$f" > "$tmp" || rc=$?
            [ "$rc" -le 1 ] || { rm -f "$tmp"; echo "  warning: could not read $f" >&2; continue; }
            [ -z "$DOCS_REPO" ] || printf "RALPH_DOCS_REPO=%s\nRALPH_DOCS_PUBLIC=%s\n" "$DOCS_REPO" "$DOCS_PUBLIC" >> "$tmp"
            chmod 600 "$tmp" && mv "$tmp" "$f"
        done'
fi

# The knowledge index (#121): clone RALPH_DOCS_REPO into the knowledge volume,
# write QMD's config, index and embed. The read token goes in by name only.
# Tolerant: a stack without network still starts, and search catches up.
# The running service is the switch (COMPOSE_PROFILES): none, no index.
if [ -n "$KNOWLEDGE_ON" ]; then
    export GH_TOKEN=${RALPH_PROFILE_READ_TOKEN:-${RALPH_GITHUB_TOKEN:-}}
    docker exec -e GH_TOKEN -e "KNOWLEDGE_REPO=${RALPH_DOCS_REPO:-}" "$RALPH_KNOWLEDGE_CONTAINER" \
        /ralph/bootstrap/knowledge-init || echo "  knowledge: index not ready; search catches up on refresh" >&2
    unset GH_TOKEN
fi

# The three skills the manifest references rather than the repository holding.
# Tolerant of a failure here: a stack that cannot reach GitHub should start
# with the skills it has and a warning, not refuse to start.
if [ -f /ralph/skills/third-party.yaml ] || [ -f "$(dirname "$0")/../skills/third-party.yaml" ]; then
    echo "  installing third-party skills from their pinned commits"
    python3 "$(dirname "$0")/install-third-party-skills" || true
fi

# Scheduled jobs from the private overlay (RALPH_PRIVATE_JOBS), each copied
# into the profile its job.env names, with its install options written into
# that profile's .env. Absent overlay or no job.env: nothing happens.
if [ -d /ralph/private-jobs ]; then
    python3 "$(dirname "$0")/install-overlay-jobs" --jobs-root /ralph/private-jobs \
        --hermes-home "${HERMES_HOME:-$HOME/.hermes}" \
        ${RALPH_HERMES_CONTAINER:+--container "$RALPH_HERMES_CONTAINER"}
fi

echo "ralph: install complete"
