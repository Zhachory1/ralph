#!/usr/bin/env python3
"""Post chat-maintainer's replies to the original Chat thread, from the host.

Three replies, each at most once per request:
  ack    - intake card decided `route`: its `ack` text, after the orchestrator card exists
  reply  - intake card decided `reply`: its `body` (cannot fulfill, or a clarifying question)
  final  - report card on the work board decided `send`: its `body`, only after the ack

The destination always comes from the staged intake evidence for the request's
operation id, never from agent-written text. Uses the host's encrypted Google
Chat credential through gchat.py; no credential reaches Hermes or a card.

Per-thread ceilings (CEILINGS) bound how many times one request's thread can be
messaged; a breach blocks the card and alerts (block_and_alert()) instead of
failing silently. A thread lock (thread_lock()) serializes the count and the
send for every operation sharing a thread.
"""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import chat_evidence

OP_ID = re.compile(r"chat-[0-9a-f]{64}\Z")
SPACE = re.compile(r"spaces/[A-Za-z0-9_-]+\Z")
URL = re.compile(r"https?://[^\s<>\"')\]]+")
GITHUB_PULL = re.compile(r"\Ahttps://github\.com/([\w.-]+)/([\w.-]+)/pull/\d+/?\Z")
GITHUB_REPO = re.compile(r"\Ahttps://github\.com/([\w.-]+)/([\w.-]+)/?\Z")
TRACKER_ISSUE_PATH = re.compile(r"/issues/\d+\b")
BARE_TRACKER_ISSUE = re.compile(r"(?<![\w#])#\d+\b")
# Known provider token shapes, plus a generic "key/token/password/secret: value"
# assignment -- the content bound is a refusal rule, not a scanner that proves
# a string is a real credential (SOUL.md:29, dd-chat.md:488-492).
CREDENTIAL = re.compile(
    r"\bgh[oprsu]_[A-Za-z0-9]{20,}\b"
    r"|\bgithub_pat_[A-Za-z0-9_]{20,}\b"
    r"|\bsk-[A-Za-z0-9]{20,}\b"
    r"|\bAKIA[0-9A-Z]{16}\b"
    r"|\bxox[baprs]-[A-Za-z0-9-]{10,}\b"
    r"|\bAIza[0-9A-Za-z_-]{35}\b"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|\b(?:api[_-]?key|token|password|secret)\s*[:=]\s*\S{8,}",
    re.IGNORECASE,
)
MARKERS = {"ack": ".receipt-sent", "reply": ".reply-sent", "clarify": ".clarify-sent",
           "decline": ".decline-sent", "final": ".final-sent"}
# `reply_kind` picks one of these three reply markers; an unrecognized or absent
# `reply_kind` falls back to the legacy "reply" marker.
REPLY_MARKERS = {"clarify": "clarify", "decline": "decline", "answer": "reply"}
# Per-thread ceilings (dd-chat.md Sec4.4): at most this many sent markers of each
# kind, counted across one request's whole thread. `reply` (a plain, uncapped
# answer) is deliberately absent.
CEILINGS = {"clarify": 2, "decline": 1, "ack": 1, "final": 1}
MAX_TEXT = 4000
# A long reply is split into at most this many messages, in order.
MAX_PARTS = 5
# A non-zero `--record` below this many consecutive attempts retries next scan,
# by itself, with no block and no alert (dd-tracker.md:322-333, plan-tracker.md
# PR 3). Five is one per scan, so five minutes before the quiet failure is made
# loud.
TRACKER_RECORD_ATTEMPTS = 5
TRACKER_RECORD_FAILURES = ".tracker-record-failures"
# What `docker exec` says, in either wording across versions, for a container
# that does not exist or is stopped. Matched only on a failed exec.
TRACKER_CONTAINER_DOWN = re.compile(r"no such container|is not running", re.IGNORECASE)


class Refused(ValueError):
    pass


def command(argv):
    """Run one command. A timeout is a failed result (124), never an exception:
    a hung `gchat.py send` or `docker exec` must fail its own operation and let
    the scan carry on with the next, not abort the whole pass. A send that timed
    out after leaving is safe to retry: every part keeps fixed ids, so the Chat
    API dedupes it."""
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", "timed out after 60s")


def tracker(root, *args):
    """`bootstrap/tracker-sync`, local or through `docker exec` into
    RALPH_TRACKER_CONTAINER -- the shape `inbox-producer:29-33` already uses,
    because the wiring lands before the compose services do (dd-tracker.md
    Sec2, :216-222). `--work-root` is `/workspaces/chat-inbox` through the
    container, the same path `chat-route`'s own docker exec call uses; the
    local fallback passes this sender's own root."""
    container = os.environ.get("RALPH_TRACKER_CONTAINER")
    if container:
        argv = ["docker", "exec", container, "python3", "/ralph/bootstrap/tracker-sync",
                *args, "--work-root", "/workspaces/chat-inbox"]
    else:
        argv = [sys.executable, str(HERE / "tracker-sync"), *args, "--work-root", str(root)]
    result = command(argv)
    if container and result.returncode and TRACKER_CONTAINER_DOWN.search(result.stderr or ""):
        # The chat-sender service names `<instance>-tracker-sync-1` by default, but
        # that container only exists once the owner starts the `tracker` profile
        # (D1). Until then every `docker exec` into it fails, and a failed
        # `--record` holds the acknowledgement: the sidecar would go silent for
        # every requester the moment it is switched on. A tracker nobody has
        # started is a tracker that is not configured, so it takes the same exit
        # as a missing key file: success, nothing recorded.
        if "--record" in args:
            print(f"tracker-sync container {container} is not running; "
                  "treating the tracker as not configured", file=sys.stderr)
        return subprocess.CompletedProcess(argv, 0, "tracker not configured\n", "")
    return result


def read_record_failures(path):
    try:
        return int(path.read_text().strip())
    except (FileNotFoundError, ValueError):
        return 0


def write_record_failures(path, count):
    """A counter, not a once-only marker: a plain open, not `O_EXCL`, because
    this step must be able to rewrite itself on every retry (dd-tracker.md
    Sec3.2, :251-260)."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(str(count))


def record_item(container, board, task_id, root, op_id):
    """`tracker-sync --record`, before the acknowledgement, on an `ack` only
    (dd-tracker.md Sec3.1, plan-tracker.md PR 3). Returns 0 to let `handle()`
    carry on to `post()` -- recorded, or tracker not configured -- or the
    value `handle()` must return instead: 1 while a transient failure is
    still inside the retry budget, 2 once a refusal or the budget itself ends
    the automatic retry and blocks the card.

    `TRACKER_RECORD_FAILURES` only ever counts a transient (exit 1) failure.
    A refusal (exit 2) blocks and alerts on its first attempt, with no retry
    budget spent, so it never touches the counter."""
    failures = root / op_id / TRACKER_RECORD_FAILURES
    result = tracker(root, "--record", op_id)
    if result.returncode == 0:
        try:
            failures.unlink()
        except FileNotFoundError:
            pass
        return 0
    if result.returncode == 2:
        reason = "tracker refused to record the item; acknowledgement not sent"
        print(reason, file=sys.stderr)
        block_and_alert(container, board, task_id, root, op_id, "tracker-record", reason)
        return 2
    attempts = read_record_failures(failures) + 1
    write_record_failures(failures, attempts)
    if attempts >= TRACKER_RECORD_ATTEMPTS:
        reason = (f"tracker-sync --record failed {attempts} times in a row; acknowledgement "
                  "not sent and the card is blocked (see docs/operations.md, Tracker sync)")
        print(reason, file=sys.stderr)
        block_and_alert(container, board, task_id, root, op_id, "tracker-record", reason)
        return 2
    print(f"tracker-sync --record failed ({attempts}/{TRACKER_RECORD_ATTEMPTS}); "
          "acknowledgement not sent, retrying next scan", file=sys.stderr)
    return 1


def alert_settle_failures(root, stderr):
    """A `--settle` failure alerts and blocks nothing (dd-tracker.md Sec3.4,
    plan-tracker.md PR 3): by the time `--settle` runs, any reply for a
    settled operation is already out, so there is no card left to block.
    Guarded by `.alerted-tracker-settle` in the failing operation's own
    directory, keyed off the `settle-failed: <op_id>` lines `tracker-sync`
    prints, so a loop reports itself once per operation rather than every
    scan."""
    for line in (stderr or "").splitlines():
        prefix = "settle-failed: "
        if not line.startswith(prefix):
            continue
        op_id = line[len(prefix):].strip()
        if not OP_ID.fullmatch(op_id):
            continue
        sentinel = root / op_id / ".alerted-tracker-settle"
        if sentinel.exists():
            continue
        notify(f"Ralph tracker settle failed for {op_id}")
        try:
            fd = os.open(sentinel, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.close(fd)
        except FileExistsError:
            pass
        except OSError:
            print(f"could not record tracker settle alert sentinel for {op_id}", file=sys.stderr)


def parse_send_switch(raw):
    """CHAT_SEND (§4.8, dd-chat.md:564-569, D9): absent means on (P1). An
    unrecognized value is treated as on and printed once -- silently going
    quiet is the failure this switch exists to prevent."""
    if raw is None:
        return True
    value = raw.strip().lower()
    if value in ("0", "false", "off", "no"):
        return False
    if value in ("1", "true", "on", "yes"):
        return True
    print(f"unrecognized CHAT_SEND value {raw!r}; treating it as on", file=sys.stderr)
    return True


def instance_config(path):
    values = {}
    for line in path.read_text().splitlines():
        if line.startswith(("RALPH_INSTANCE=", "RALPH_WORKSPACES=", "CHAT_ROUTE_SPACES=",
                             "RALPH_TRACKER_HOST=", "CHAT_SEND=")):
            key, value = line.split("=", 1)
            values[key] = value.strip().strip("'\"")
    instance = values["RALPH_INSTANCE"]
    spaces = set(values["CHAT_ROUTE_SPACES"].split())
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", instance) or not spaces \
            or len(spaces) > 8 or any(not SPACE.fullmatch(space) for space in spaces):
        raise ValueError("invalid Chat pilot configuration")
    root = (path.parent / values["RALPH_WORKSPACES"] / "chat-inbox").resolve()
    send_enabled = parse_send_switch(values.get("CHAT_SEND"))
    return (instance + "-hermes-1", root, spaces, values.get("RALPH_TRACKER_HOST") or None,
            send_enabled)


def operation_of(task):
    ops = [line.partition(": ")[2] for line in (task.get("body") or "").splitlines()
           if line.startswith("operation_id: ")]
    if len(ops) != 1 or not OP_ID.fullmatch(ops[0]):
        raise Refused("invalid Chat operation")
    return ops[0]


def destination(root, op_id, allowed_spaces):
    """The original space, thread and staged item, read only from staged
    intake evidence, never from agent text."""
    item = chat_evidence.read_item(root, op_id)
    if item["space"] not in allowed_spaces:
        raise Refused("Chat destination or sender is not authorized")
    return item


def decision_of(detail):
    run = detail["runs"][-1]
    if run["outcome"] != "completed" or not isinstance(run["metadata"], dict):
        raise Refused("missing Chat decision")
    metadata = run["metadata"]
    # Extra keys (e.g. a worker's `diagnosis` note) are ignored, not refused:
    # only decision/body/ack are ever read.
    if not {"decision", "body"} <= set(metadata):
        raise Refused("invalid Chat decision")
    return metadata


def text(value):
    if not isinstance(value, str) or not value.strip() or len(parts(value)) > MAX_PARTS:
        raise Refused("reply text missing or too long")
    return value


def parts(body):
    """Split into messages of at most MAX_TEXT characters, in order: at the
    last paragraph break that fits, else the last line break, else a hard cut."""
    chunks = []
    while len(body) > MAX_TEXT:
        window = body[:MAX_TEXT + 1]
        cut = window.rfind("\n\n")
        sep = 2
        if cut <= 0:
            cut, sep = window.rfind("\n"), 1
        if cut <= 0:
            cut, sep = MAX_TEXT, 0
        chunks.append(body[:cut])
        body = body[cut + sep:]
    chunks.append(body)
    return [c for c in chunks if c.strip()]


def has_tracker_reference(body, tracker_host):
    """A work-tracker reference (R1, prd.md:594-595): the instance's tracker
    host when RALPH_TRACKER_HOST is set, an `/issues/<n>` path, or a bare
    `#<n>`. The path and bare-issue patterns are host-agnostic by design: the
    bound is a refusal rule, not a scanner that proves a string names this
    request's own tracker item."""
    if tracker_host and tracker_host in body:
        return True
    return bool(TRACKER_ISSUE_PATH.search(body) or BARE_TRACKER_ISSUE.search(body))


def has_credential(body):
    return bool(CREDENTIAL.search(body))


def github_repo_is_public(owner, repo):
    """One unauthenticated read: GET https://api.github.com/repos/<owner>/<repo>.
    No token is sent, so the sender gains no repository credential; a non-200
    (including an HTTPError for a private or missing repository) means "not
    reachable", which refuses (R19, prd.md:597-598)."""
    url = "https://api.github.com/repos/%s/%s" % (owner, repo)
    request = urllib.request.Request(
        url, headers={"Accept": "application/vnd.github+json", "User-Agent": "ralph-chat-reply"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            if response.status != 200:
                return False
            data = json.loads(response.read())
    except (OSError, ValueError):
        return False
    return isinstance(data, dict) and data.get("private") is False


def reachable(url):
    """A URL qualifies only if provably public: a GitHub pull request or
    repository URL, checked live against the unauthenticated API above.
    Everything else never qualifies (R19, prd.md:597-598)."""
    match = GITHUB_PULL.match(url) or GITHUB_REPO.match(url)
    if not match:
        return False
    return github_repo_is_public(match.group(1), match.group(2))


def refuse_unsendable(body, tracker_host):
    """Run before any send of agent text -- `ack`, every `reply_kind`,
    `final` (§4.5, dd-chat.md:475-511). A reply can quote a private
    repository the requester cannot open, so this is a refusal in the
    sender, not a trim. **The honest limit:** prose cannot be proven to come
    from this request -- this catches references and links, not a sentence
    that paraphrases a private document; that residual risk is accepted, not
    designed away (D2)."""
    if has_tracker_reference(body, tracker_host):
        raise Refused("reply text names the work tracker")
    if has_credential(body):
        raise Refused("reply text looks like it carries a credential")
    for url in URL.findall(body):
        # A link at the end of a sentence carries the sentence's punctuation:
        # "see https://github.com/o/r/pull/1." must be checked as the link, not
        # refused for a trailing dot. Only these characters, and only at the end.
        url = url.rstrip(".,;:!?")
        if not reachable(url):
            raise Refused("reply text links to something the requester cannot already open")
    return body


def post(space, thread, body, kind, op_id):
    """Each part keeps fixed ids across retries, so the Chat API dedupes a
    part that already went out and a retry resumes where it failed. Part 1
    keeps the original ids, so a single-message reply is unchanged."""
    digest = hashlib.sha256(op_id.encode()).hexdigest()
    sender = pathlib.Path(__file__).resolve().parent.parent / "skills/ops/google-chat/gchat.py"
    for n, part in enumerate(parts(body), 1):
        suffix = "" if n == 1 else f"-{n}"
        sent = command([sys.executable, str(sender), "send", space, part,
                        "--thread", thread, "--strict-thread",
                        "--request-id", f"ralph-{kind}-{digest}{suffix}",
                        "--message-id", f"client-ralph-{kind}-{digest[:40]}{suffix}"])
        if sent.returncode:
            return False
        try:
            if json.loads(sent.stdout).get("sent") is not True:
                return False
        except (ValueError, AttributeError):
            return False
    return True


def mark(root, op_id, kind):
    fd = os.open(root / op_id / MARKERS[kind], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    os.close(fd)


def hold(root, op_id, kind):
    """A reply held by the send switch (§4.8, dd-chat.md:581-595) writes this
    marker in place of the one `mark()` would have written, through the same
    `O_EXCL` open, so the loop stays bounded at one attempt per operation and
    kind instead of re-handling it every scan."""
    fd = os.open(root / op_id / f".held-{kind}", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    os.close(fd)


def sent(root, op_id, kind):
    # A thread already answered before markers became per kind carries only the
    # legacy `.reply-sent`; it satisfies every reply kind so no reply resends.
    if kind in REPLY_MARKERS.values() and (root / op_id / MARKERS["reply"]).is_file():
        return True
    return (root / op_id / MARKERS[kind]).is_file()


def held(root, op_id, kind):
    return (root / op_id / f".held-{kind}").is_file()


def answered(root, op_id, kind):
    """A sent or a held marker both mean "nothing to do here" for this
    operation and kind (dd-chat.md:589-591): sent because the reply already
    went out, held because the switch already decided not to send it."""
    return sent(root, op_id, kind) or held(root, op_id, kind)


@contextlib.contextmanager
def thread_lock(root, thread):
    """An exclusive flock on a file named for the thread (dd-chat.md:453-468),
    so two operations in the same thread never count or send at once. Per
    thread, not per operation: several messages in one thread are separate
    operations, and operation-scoped locks would never see each other."""
    locks = root / ".locks"
    locks.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256(thread.encode()).hexdigest()
    fd = os.open(locks / f"{digest}.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def thread_count(root, op_id, item, kind):
    """Sent `kind` markers across this operation and every `prior_operations`
    directory in its staged item -- never held markers, so a reply held by the
    send switch cannot spend a ceiling."""
    return sum(1 for op in (op_id, *item.get("prior_operations", []))
               if (root / op / MARKERS[kind]).is_file())


def notify(text):
    """Best effort: an alert that fails to send must not stop the hold
    (maintain-pr:303-305)."""
    url = os.environ.get("RALPH_NOTIFY_URL") or os.environ.get("GCHAT_WEBHOOK_URL")
    if not url:
        print(f"notify (no webhook set): {text}", file=sys.stderr)
        return
    import urllib.request
    try:
        req = urllib.request.Request(url, data=json.dumps({"text": text}).encode(),
                                     headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=15).close()
    except Exception as exc:  # noqa: BLE001 -- best effort by design
        print(f"notify failed: {exc}", file=sys.stderr)


def block_and_alert(container, board, task_id, root, op_id, kind, reason, block=True):
    """Tell the owner once per operation and kind, guarded by an
    `.alerted-<kind>` sentinel (dd-chat.md:513-537).

    `block=True` is for a REFUSAL: the card is taken out of the sender's
    `--status done` listing and is not tried again. `block=False` is for a
    RETRYABLE failure (return 1): the card must stay `done`, because that
    listing is exactly what the next scan retries from, and removing it would
    end the retry the alert is reporting. The design says both fire on a retry;
    they cannot both hold, so a retry alerts and a refusal removes and alerts.

    Every card `handle()` refuses is already `done` (that status is checked on
    entry), and the kanban kernel's `block_task` only transitions
    running/ready -> blocked, never done -> blocked: `kanban block` on a done
    card always fails, so the card would be rediscovered and re-refused every
    scan forever. `archive` is the kernel's one done -> terminal transition, so
    a refusal comments the reason (parity with what `kanban block` records)
    and archives the card instead.

    The sentinel is written only after the action it guards has happened. A
    removal that failed leaves no sentinel, so the next scan tries it again;
    writing the sentinel first would turn one failed `docker exec` into a card
    that is never removed and never reported."""
    sentinel = root / op_id / f".alerted-{kind}"
    if sentinel.exists():
        return
    if block:
        commented = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                             "--board", board, "comment", task_id, f"BLOCKED: {reason}"])
        if commented.returncode:
            print(f"could not comment on Chat card {task_id}: {commented.stderr.strip()[:300]}",
                  file=sys.stderr)
            return
        archived = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                            "--board", board, "archive", task_id])
        if archived.returncode:
            print(f"could not archive Chat card {task_id}: {archived.stderr.strip()[:300]}",
                  file=sys.stderr)
            return
    notify(f"Ralph chat {kind} for {task_id} ({op_id}): {reason}")
    try:
        fd = os.open(sentinel, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.close(fd)
    except FileExistsError:
        pass
    except OSError:
        print(f"could not record Chat alert sentinel for {op_id}/{kind}", file=sys.stderr)


def handle(container, root, allowed_spaces, board, task_id, tracker_host=None, send_enabled=True):
    """0 done or nothing to send, 1 retryable failure, 2 refused."""
    op_id = kind = None
    try:
        shown = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                         "--board", board, "show", task_id, "--json"])
        if shown.returncode:
            print(f"cannot read Chat card {task_id}", file=sys.stderr)
            return 1
        detail = json.loads(shown.stdout)
        task = detail["task"]
        if task["id"] != task_id or task["status"] != "done" \
                or task["assignee"] != "ralph-chat-maintainer":
            raise Refused("Chat card is not complete")
        op_id = operation_of(task)
        metadata = decision_of(detail)
        choice = metadata["decision"]
        if board == "queues":
            if task["workspace_path"] != "/workspaces/chat-inbox/" + op_id:
                raise Refused("Chat workspace differs from operation")
            if choice == "route":
                kind = "ack"
                body = refuse_unsendable(text(metadata.get("ack")), tracker_host)
            elif choice == "reply":
                kind = REPLY_MARKERS.get(metadata.get("reply_kind"), "reply")
                body = refuse_unsendable(text(metadata["body"]), tracker_host)
            else:
                return 0
        else:
            if choice != "send":
                return 0
            kind = "final"
            body = refuse_unsendable(text(metadata["body"]), tracker_host)
            # The switch is read before this check (dd-chat.md:597-603): a
            # final is refused for a missing acknowledgement only while the
            # switch is on. Off, a held final is held, not refused -- every
            # acknowledgement of the pilot week is held too, and refusing each
            # final against them would block and alert once per card for
            # nothing a requester did.
            # An already-answered final (sent, or held while the switch was
            # off) has nothing left to decide. Without this, flipping the
            # switch on and calling `--task` for a held final would fail the
            # ack check below and block a card that is correctly finished.
            if answered(root, op_id, "final"):
                return 0
            if send_enabled and not sent(root, op_id, "ack"):
                raise Refused("final response before the request was acknowledged")
        item = destination(root, op_id, allowed_spaces)
    except (KeyError, IndexError, ValueError, TypeError, OSError, json.JSONDecodeError) as error:
        reason = str(error) if isinstance(error, (Refused, chat_evidence.Invalid)) \
            else "invalid bound decision or destination"
        print(f"refused Chat {task_id}: {reason}", file=sys.stderr)
        if op_id and kind:
            block_and_alert(container, board, task_id, root, op_id, kind, reason)
        return 2

    space, thread = item["space"], item["thread"]
    with thread_lock(root, thread):
        if answered(root, op_id, kind):
            return 0
        if kind in CEILINGS and thread_count(root, op_id, item, kind) >= CEILINGS[kind]:
            reason = f"{kind} ceiling reached for this thread"
            if kind == "ack":
                # R6: held for the next scan, not refused -- the request keeps
                # waiting rather than being told it cannot be acknowledged.
                print(f"Chat {kind} held for {task_id}: {reason}", file=sys.stderr)
                block_and_alert(container, board, task_id, root, op_id, kind, reason,
                                block=False)
                return 1
            print(f"refused Chat {task_id}: {reason}", file=sys.stderr)
            block_and_alert(container, board, task_id, root, op_id, kind, reason)
            return 2

        if kind == "ack":
            routed = command(["docker", "exec", "-u", "hermes", container, "python3",
                              "/ralph/bootstrap/chat-route", "--task", task_id,
                              "--work-root", "/workspaces/chat-inbox"])
            if routed.returncode or not routed.stdout.startswith("routed: t_"):
                reason = "cannot confirm orchestrator card; acknowledgement not sent"
                print(reason, file=sys.stderr)
                block_and_alert(container, board, task_id, root, op_id, kind, reason,
                                block=False)
                return 1
            record_result = record_item(container, board, task_id, root, op_id)
            if record_result:
                return record_result
        if not send_enabled:
            # A held reply is not a failure: it must neither block nor alert
            # as one (§4.8). `mark()` never runs, so the ceilings stay exact.
            try:
                hold(root, op_id, kind)
            except FileExistsError:
                pass
            except OSError:
                reason = f"Chat {kind} held but not recorded; retry is safe"
                print(reason, file=sys.stderr)
                return 1
            print(f"Chat {kind} held for {task_id}")
            return 0
        if not post(space, thread, body, kind, op_id):
            reason = f"Chat {kind} failed for {task_id}; retry reuses the same ids"
            print(reason, file=sys.stderr)
            block_and_alert(container, board, task_id, root, op_id, kind, reason,
                            block=False)
            return 1
        try:
            mark(root, op_id, kind)
        except FileExistsError:
            pass
        except OSError:
            reason = f"Chat {kind} sent but not recorded; retry is safe"
            print(reason, file=sys.stderr)
            block_and_alert(container, board, task_id, root, op_id, kind, reason,
                            block=False)
            return 1
        print(f"Chat {kind} sent for {task_id}")
        return 0


def scan(instance_env):
    try:
        container, root, allowed_spaces, tracker_host, send_enabled = instance_config(instance_env)
    except (OSError, ValueError, KeyError):
        print("invalid Chat pilot configuration", file=sys.stderr)
        return 1
    status = 0
    # Once per scan, before any card is handled: everything `--settle` does
    # happens after a reply has already gone out (dd-tracker.md:240-243), so a
    # failure here sets the scan's exit status and alerts, and withholds no
    # reply (plan-tracker.md PR 3).
    settled = tracker(root, "--settle")
    if settled.returncode:
        status = 1
        alert_settle_failures(root, settled.stderr)
    for board in ("queues", "ralph"):
        listed = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                          "--board", board, "list", "--assignee", "ralph-chat-maintainer",
                          "--status", "done", "--json"])
        try:
            if listed.returncode:
                raise ValueError("list failed")
            tasks = json.loads(listed.stdout)
            tasks = tasks if isinstance(tasks, list) else tasks["tasks"]
        except (ValueError, KeyError, TypeError):
            print(f"could not list completed Chat cards on {board}", file=sys.stderr)
            status = 1
            continue
        for task in tasks:
            try:
                op_id = operation_of(task)
            except Refused:
                continue
            if board == "ralph" and answered(root, op_id, "final"):
                continue
            if board == "queues" and (answered(root, op_id, "ack") or answered(root, op_id, "reply")
                                       or answered(root, op_id, "clarify")
                                       or answered(root, op_id, "decline")):
                continue
            if handle(container, root, allowed_spaces, board, task["id"], tracker_host,
                      send_enabled) == 1:
                status = 1
    return status


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--task")
    parser.add_argument("--board", default="queues", choices=("queues", "ralph"))
    parser.add_argument("--scan", action="store_true")
    parser.add_argument("--instance-env", required=True, type=pathlib.Path)
    args = parser.parse_args()
    if bool(args.task) == args.scan:
        parser.error("choose exactly one of --task or --scan")
    if args.scan:
        return scan(args.instance_env)
    container, root, allowed_spaces, tracker_host, send_enabled = instance_config(args.instance_env)
    return handle(container, root, allowed_spaces, args.board, args.task, tracker_host, send_enabled)


if __name__ == "__main__":
    sys.exit(main())
