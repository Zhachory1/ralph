#!/usr/bin/env python3
"""Send one fixed Chat receipt from the host after a trusted route succeeds.

Uses the host's encrypted Google Chat credential through the existing gchat.py
command. No credential is passed to Hermes or stored in a Kanban card.
"""

import argparse
import hashlib
import json
import os
import pathlib
import re
import stat
import subprocess
import sys

OP_ID = re.compile(r"chat-[0-9a-f]{64}\Z")
SPACE = re.compile(r"spaces/[A-Za-z0-9_-]+\Z")
THREAD = re.compile(r"spaces/[A-Za-z0-9_-]+/threads/[A-Za-z0-9_.-]+\Z")
RECEIPT = "I got your message and I'm working on it."


def command(argv):
    return subprocess.run(argv, capture_output=True, text=True, timeout=60)


def instance_config(path):
    values = {}
    for line in path.read_text().splitlines():
        if line.startswith(("RALPH_INSTANCE=", "RALPH_WORKSPACES=", "CHAT_ROUTE_SPACES=")):
            key, value = line.split("=", 1)
            values[key] = value.strip().strip("'\"")
    instance = values["RALPH_INSTANCE"]
    spaces = set(values["CHAT_ROUTE_SPACES"].split())
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", instance) or not spaces \
            or len(spaces) > 8 or any(not SPACE.fullmatch(space) for space in spaces):
        raise ValueError("invalid Chat pilot configuration")
    root = (path.parent / values["RALPH_WORKSPACES"] / "chat-inbox").resolve()
    return instance + "-hermes-1", root, spaces


def send_once(task_id, instance_env, marker=None):
    try:
        container, root, allowed_spaces = instance_config(instance_env)
        shown = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                         "--board", "queues", "show", task_id, "--json"])
        if shown.returncode:
            print("cannot read completed Chat card", file=sys.stderr)
            return 1
        detail = json.loads(shown.stdout)
        task = detail["task"]
        if task["id"] != task_id or task["status"] != "done" \
                or task["assignee"] != "ralph-chat-maintainer":
            raise ValueError("Chat decision is not complete")
        ops = [line.partition(": ")[2] for line in task["body"].splitlines()
               if line.startswith("operation_id: ")]
        if len(ops) != 1 or not OP_ID.fullmatch(ops[0]):
            raise ValueError("invalid Chat operation")
        op_id = ops[0]
        if task["workspace_path"] != "/workspaces/chat-inbox/" + op_id:
            raise ValueError("Chat workspace differs from operation")
        workspace = root / op_id
        evidence = workspace / "evidence"
        path = evidence / "item.json"
        if workspace.is_symlink() or evidence.is_symlink() or path.is_symlink():
            raise ValueError("unsafe Chat evidence")
        info = path.stat()
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > 65_536 \
                or info.st_mode & 0o077:
            raise ValueError("unsafe Chat evidence")
        item = json.loads(path.read_text())
        run = detail["runs"][-1]
        if run["outcome"] != "completed" or not isinstance(run["metadata"], dict):
            raise ValueError("missing Chat decision")
        metadata = run["metadata"]
        if not {"decision", "body"} <= set(metadata) or set(metadata) - {"decision", "body", "worker_session_id"}:
            raise ValueError("invalid Chat decision")
        if metadata["decision"] != "route":
            print("no automatic receipt for this Chat decision")
            return 0
        space, thread = item["space"], item["thread"]
        message = item["messages"][-1]["name"]
        if item["kind"] != "inbound" or item["sender_trusted"] is not True \
                or space not in allowed_spaces or not THREAD.fullmatch(thread) \
                or not thread.startswith(space + "/threads/") or not isinstance(message, str) \
                or not message.startswith(space + "/messages/") \
                or op_id != "chat-" + hashlib.sha256(message.encode()).hexdigest():
            raise ValueError("Chat destination or sender is not authorized")
    except (KeyError, IndexError, ValueError, TypeError, OSError, json.JSONDecodeError):
        print("refused Chat receipt: invalid bound decision or destination", file=sys.stderr)
        return 2

    routed = command(["docker", "exec", "-u", "hermes", container, "python3",
                      "/ralph/bootstrap/chat-route", "--task", task_id,
                      "--work-root", "/workspaces/chat-inbox"])
    if routed.returncode or not routed.stdout.startswith("routed: t_"):
        print("cannot confirm orchestrator card; no Chat receipt sent", file=sys.stderr)
        return 1
    request_id = "ralph-ack-" + hashlib.sha256(op_id.encode()).hexdigest()
    sender = pathlib.Path(__file__).resolve().parent.parent / "skills/ops/google-chat/gchat.py"
    sent = command([sys.executable, str(sender), "send", space, RECEIPT,
                    "--thread", thread, "--strict-thread", "--request-id", request_id])
    if sent.returncode:
        print("Chat receipt failed; retry with the same request id", file=sys.stderr)
        return 1
    try:
        if json.loads(sent.stdout).get("sent") is not True:
            raise ValueError("send not confirmed")
    except (ValueError, AttributeError):
        print("Chat receipt unconfirmed; retry with the same request id", file=sys.stderr)
        return 1
    if marker is not None:
        try:
            fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w") as stream:
                stream.write(request_id)
        except FileExistsError:
            pass
        except OSError:
            print("Chat receipt confirmed but marker could not be saved; retry is safe", file=sys.stderr)
            return 1
    print("Chat receipt confirmed for " + task_id)
    return 0


def scan(instance_env):
    try:
        container, root, _ = instance_config(instance_env)
        listed = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                          "--board", "queues", "list", "--assignee", "ralph-chat-maintainer",
                          "--status", "done", "--json"])
        if listed.returncode:
            raise ValueError("could not list completed Chat cards")
        tasks = json.loads(listed.stdout)
        tasks = tasks if isinstance(tasks, list) else tasks["tasks"]
        for task in tasks:
            ops = [line.partition(": ")[2] for line in (task.get("body") or "").splitlines()
                   if line.startswith("operation_id: ")]
            if len(ops) != 1 or not OP_ID.fullmatch(ops[0]):
                continue
            marker = root / ops[0] / ".receipt-sent"
            if marker.is_file():
                continue
            if send_once(task["id"], instance_env, marker):
                return 1
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
        print("could not scan completed Chat cards", file=sys.stderr)
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task")
    parser.add_argument("--scan", action="store_true")
    parser.add_argument("--instance-env", required=True, type=pathlib.Path)
    args = parser.parse_args()
    if bool(args.task) == args.scan:
        parser.error("choose exactly one of --task or --scan")
    return scan(args.instance_env) if args.scan else send_once(args.task, args.instance_env)


if __name__ == "__main__":
    sys.exit(main())
