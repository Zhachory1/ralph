#!/usr/bin/env python3
"""Post chat-maintainer's replies to the original Chat thread, from the host.

Three replies, each at most once per request:
  ack    - intake card decided `route`: its `ack` text, after the orchestrator card exists
  reply  - intake card decided `reply`: its `body` (cannot fulfill, or a clarifying question)
  final  - report card on the work board decided `send`: its `body`, only after the ack

The destination always comes from the staged intake evidence for the request's
operation id, never from agent-written text. Uses the host's encrypted Google
Chat credential through gchat.py; no credential reaches Hermes or a card.

Per-thread ceilings (CEILINGS) bound how many times one request's thread can be
messaged; a breach blocks the card and alerts (block_and_alert()) instead of
failing silently. A thread lock (thread_lock()) serializes the count and the
send for every operation sharing a thread.
"""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import chat_evidence

OP_ID = re.compile(r"chat-[0-9a-f]{64}\Z")
SPACE = re.compile(r"spaces/[A-Za-z0-9_-]+\Z")
MARKERS = {"ack": ".receipt-sent", "reply": ".reply-sent", "clarify": ".clarify-sent",
           "decline": ".decline-sent", "final": ".final-sent"}
# `reply_kind` picks one of these three reply markers; an unrecognized or absent
# `reply_kind` falls back to the legacy "reply" marker.
REPLY_MARKERS = {"clarify": "clarify", "decline": "decline", "answer": "reply"}
# Per-thread ceilings (dd-chat.md Sec4.4): at most this many sent markers of each
# kind, counted across one request's whole thread. `reply` (a plain, uncapped
# answer) is deliberately absent.
CEILINGS = {"clarify": 2, "decline": 1, "ack": 1, "final": 1}
MAX_TEXT = 4000
# A long reply is split into at most this many messages, in order.
MAX_PARTS = 5


class Refused(ValueError):
    pass


def command(argv):
    """Run one command. A timeout is a failed result (124), never an exception:
    a hung `gchat.py send` or `docker exec` must fail its own operation and let
    the scan carry on with the next, not abort the whole pass. A send that timed
    out after leaving is safe to retry: every part keeps fixed ids, so the Chat
    API dedupes it."""
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", "timed out after 60s")


def instance_config(path):
    values = {}
    for line in path.read_text().splitlines():
        if line.startswith(("RALPH_INSTANCE=", "RALPH_WORKSPACES=", "CHAT_ROUTE_SPACES=")):
            key, value = line.split("=", 1)
            values[key] = value.strip().strip("'\"")
    instance = values["RALPH_INSTANCE"]
    spaces = set(values["CHAT_ROUTE_SPACES"].split())
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", instance) or not spaces \
            or len(spaces) > 8 or any(not SPACE.fullmatch(space) for space in spaces):
        raise ValueError("invalid Chat pilot configuration")
    root = (path.parent / values["RALPH_WORKSPACES"] / "chat-inbox").resolve()
    return instance + "-hermes-1", root, spaces


def operation_of(task):
    ops = [line.partition(": ")[2] for line in (task.get("body") or "").splitlines()
           if line.startswith("operation_id: ")]
    if len(ops) != 1 or not OP_ID.fullmatch(ops[0]):
        raise Refused("invalid Chat operation")
    return ops[0]


def destination(root, op_id, allowed_spaces):
    """The original space, thread and staged item, read only from staged
    intake evidence, never from agent text."""
    item = chat_evidence.read_item(root, op_id)
    if item["space"] not in allowed_spaces:
        raise Refused("Chat destination or sender is not authorized")
    return item


def decision_of(detail):
    run = detail["runs"][-1]
    if run["outcome"] != "completed" or not isinstance(run["metadata"], dict):
        raise Refused("missing Chat decision")
    metadata = run["metadata"]
    # Extra keys (e.g. a worker's `diagnosis` note) are ignored, not refused:
    # only decision/body/ack are ever read.
    if not {"decision", "body"} <= set(metadata):
        raise Refused("invalid Chat decision")
    return metadata


def text(value):
    if not isinstance(value, str) or not value.strip() or len(parts(value)) > MAX_PARTS:
        raise Refused("reply text missing or too long")
    return value


def parts(body):
    """Split into messages of at most MAX_TEXT characters, in order: at the
    last paragraph break that fits, else the last line break, else a hard cut."""
    chunks = []
    while len(body) > MAX_TEXT:
        window = body[:MAX_TEXT + 1]
        cut = window.rfind("\n\n")
        sep = 2
        if cut <= 0:
            cut, sep = window.rfind("\n"), 1
        if cut <= 0:
            cut, sep = MAX_TEXT, 0
        chunks.append(body[:cut])
        body = body[cut + sep:]
    chunks.append(body)
    return [c for c in chunks if c.strip()]


def post(space, thread, body, kind, op_id):
    """Each part keeps fixed ids across retries, so the Chat API dedupes a
    part that already went out and a retry resumes where it failed. Part 1
    keeps the original ids, so a single-message reply is unchanged."""
    digest = hashlib.sha256(op_id.encode()).hexdigest()
    sender = pathlib.Path(__file__).resolve().parent.parent / "skills/ops/google-chat/gchat.py"
    for n, part in enumerate(parts(body), 1):
        suffix = "" if n == 1 else f"-{n}"
        sent = command([sys.executable, str(sender), "send", space, part,
                        "--thread", thread, "--strict-thread",
                        "--request-id", f"ralph-{kind}-{digest}{suffix}",
                        "--message-id", f"client-ralph-{kind}-{digest[:40]}{suffix}"])
        if sent.returncode:
            return False
        try:
            if json.loads(sent.stdout).get("sent") is not True:
                return False
        except (ValueError, AttributeError):
            return False
    return True


def mark(root, op_id, kind):
    fd = os.open(root / op_id / MARKERS[kind], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    os.close(fd)


def sent(root, op_id, kind):
    # A thread already answered before markers became per kind carries only the
    # legacy `.reply-sent`; it satisfies every reply kind so no reply resends.
    if kind in REPLY_MARKERS.values() and (root / op_id / MARKERS["reply"]).is_file():
        return True
    return (root / op_id / MARKERS[kind]).is_file()


@contextlib.contextmanager
def thread_lock(root, thread):
    """An exclusive flock on a file named for the thread (dd-chat.md:453-468),
    so two operations in the same thread never count or send at once. Per
    thread, not per operation: several messages in one thread are separate
    operations, and operation-scoped locks would never see each other."""
    locks = root / ".locks"
    locks.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256(thread.encode()).hexdigest()
    fd = os.open(locks / f"{digest}.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def thread_count(root, op_id, item, kind):
    """Sent `kind` markers across this operation and every `prior_operations`
    directory in its staged item -- never held markers, so a reply held by the
    send switch cannot spend a ceiling."""
    return sum(1 for op in (op_id, *item.get("prior_operations", []))
               if (root / op / MARKERS[kind]).is_file())


def notify(text):
    """Best effort: an alert that fails to send must not stop the hold
    (maintain-pr:303-305)."""
    url = os.environ.get("RALPH_NOTIFY_URL") or os.environ.get("GCHAT_WEBHOOK_URL")
    if not url:
        print(f"notify (no webhook set): {text}", file=sys.stderr)
        return
    import urllib.request
    try:
        req = urllib.request.Request(url, data=json.dumps({"text": text}).encode(),
                                     headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=15).close()
    except Exception as exc:  # noqa: BLE001 -- best effort by design
        print(f"notify failed: {exc}", file=sys.stderr)


def block_and_alert(container, board, task_id, root, op_id, kind, reason, block=True):
    """Tell the owner once per operation and kind, guarded by an
    `.alerted-<kind>` sentinel (dd-chat.md:513-537).

    `block=True` is for a REFUSAL: the card is blocked, so it leaves the
    sender's `--status done` listing and is not tried again. `block=False` is
    for a RETRYABLE failure (return 1): the card must stay `done`, because that
    listing is exactly what the next scan retries from, and blocking it would
    end the retry the alert is reporting. The design says both fire on a retry;
    they cannot both hold, so a retry alerts and a refusal blocks and alerts.

    The sentinel is written only after the action it guards has happened. A
    block that failed leaves no sentinel, so the next scan tries it again;
    writing the sentinel first would turn one failed `docker exec` into a card
    that is never blocked and never reported."""
    sentinel = root / op_id / f".alerted-{kind}"
    if sentinel.exists():
        return
    if block:
        blocked = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                           "--board", board, "block", task_id, reason])
        if blocked.returncode:
            print(f"could not block Chat card {task_id}: {blocked.stderr.strip()[:300]}",
                  file=sys.stderr)
            return
    notify(f"Ralph chat {kind} for {task_id} ({op_id}): {reason}")
    try:
        fd = os.open(sentinel, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.close(fd)
    except FileExistsError:
        pass
    except OSError:
        print(f"could not record Chat alert sentinel for {op_id}/{kind}", file=sys.stderr)


def handle(container, root, allowed_spaces, board, task_id):
    """0 done or nothing to send, 1 retryable failure, 2 refused."""
    op_id = kind = None
    try:
        shown = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                         "--board", board, "show", task_id, "--json"])
        if shown.returncode:
            print(f"cannot read Chat card {task_id}", file=sys.stderr)
            return 1
        detail = json.loads(shown.stdout)
        task = detail["task"]
        if task["id"] != task_id or task["status"] != "done" \
                or task["assignee"] != "ralph-chat-maintainer":
            raise Refused("Chat card is not complete")
        op_id = operation_of(task)
        metadata = decision_of(detail)
        choice = metadata["decision"]
        if board == "queues":
            if task["workspace_path"] != "/workspaces/chat-inbox/" + op_id:
                raise Refused("Chat workspace differs from operation")
            if choice == "route":
                kind = "ack"
                body = text(metadata.get("ack"))
            elif choice == "reply":
                kind = REPLY_MARKERS.get(metadata.get("reply_kind"), "reply")
                body = text(metadata["body"])
            else:
                return 0
        else:
            if choice != "send":
                return 0
            kind = "final"
            body = text(metadata["body"])
            if not sent(root, op_id, "ack"):
                raise Refused("final response before the request was acknowledged")
        item = destination(root, op_id, allowed_spaces)
    except (KeyError, IndexError, ValueError, TypeError, OSError, json.JSONDecodeError) as error:
        reason = str(error) if isinstance(error, (Refused, chat_evidence.Invalid)) \
            else "invalid bound decision or destination"
        print(f"refused Chat {task_id}: {reason}", file=sys.stderr)
        if op_id and kind:
            block_and_alert(container, board, task_id, root, op_id, kind, reason)
        return 2

    space, thread = item["space"], item["thread"]
    with thread_lock(root, thread):
        if sent(root, op_id, kind):
            return 0
        if kind in CEILINGS and thread_count(root, op_id, item, kind) >= CEILINGS[kind]:
            reason = f"{kind} ceiling reached for this thread"
            if kind == "ack":
                # R6: held for the next scan, not refused -- the request keeps
                # waiting rather than being told it cannot be acknowledged.
                print(f"Chat {kind} held for {task_id}: {reason}", file=sys.stderr)
                block_and_alert(container, board, task_id, root, op_id, kind, reason,
                                block=False)
                return 1
            print(f"refused Chat {task_id}: {reason}", file=sys.stderr)
            block_and_alert(container, board, task_id, root, op_id, kind, reason)
            return 2

        if kind == "ack":
            routed = command(["docker", "exec", "-u", "hermes", container, "python3",
                              "/ralph/bootstrap/chat-route", "--task", task_id,
                              "--work-root", "/workspaces/chat-inbox"])
            if routed.returncode or not routed.stdout.startswith("routed: t_"):
                reason = "cannot confirm orchestrator card; acknowledgement not sent"
                print(reason, file=sys.stderr)
                block_and_alert(container, board, task_id, root, op_id, kind, reason,
                                block=False)
                return 1
        if not post(space, thread, body, kind, op_id):
            reason = f"Chat {kind} failed for {task_id}; retry reuses the same ids"
            print(reason, file=sys.stderr)
            block_and_alert(container, board, task_id, root, op_id, kind, reason,
                            block=False)
            return 1
        try:
            mark(root, op_id, kind)
        except FileExistsError:
            pass
        except OSError:
            reason = f"Chat {kind} sent but not recorded; retry is safe"
            print(reason, file=sys.stderr)
            block_and_alert(container, board, task_id, root, op_id, kind, reason,
                            block=False)
            return 1
        print(f"Chat {kind} sent for {task_id}")
        return 0


def scan(instance_env):
    try:
        container, root, allowed_spaces = instance_config(instance_env)
    except (OSError, ValueError, KeyError):
        print("invalid Chat pilot configuration", file=sys.stderr)
        return 1
    status = 0
    for board in ("queues", "ralph"):
        listed = command(["docker", "exec", "-u", "hermes", container, "hermes", "kanban",
                          "--board", board, "list", "--assignee", "ralph-chat-maintainer",
                          "--status", "done", "--json"])
        try:
            if listed.returncode:
                raise ValueError("list failed")
            tasks = json.loads(listed.stdout)
            tasks = tasks if isinstance(tasks, list) else tasks["tasks"]
        except (ValueError, KeyError, TypeError):
            print(f"could not list completed Chat cards on {board}", file=sys.stderr)
            status = 1
            continue
        for task in tasks:
            try:
                op_id = operation_of(task)
            except Refused:
                continue
            if board == "ralph" and sent(root, op_id, "final"):
                continue
            if board == "queues" and (sent(root, op_id, "ack") or sent(root, op_id, "reply")
                                       or sent(root, op_id, "clarify") or sent(root, op_id, "decline")):
                continue
            if handle(container, root, allowed_spaces, board, task["id"]) == 1:
                status = 1
    return status


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--task")
    parser.add_argument("--board", default="queues", choices=("queues", "ralph"))
    parser.add_argument("--scan", action="store_true")
    parser.add_argument("--instance-env", required=True, type=pathlib.Path)
    args = parser.parse_args()
    if bool(args.task) == args.scan:
        parser.error("choose exactly one of --task or --scan")
    if args.scan:
        return scan(args.instance_env)
    container, root, allowed_spaces = instance_config(args.instance_env)
    return handle(container, root, allowed_spaces, args.board, args.task)


if __name__ == "__main__":
    sys.exit(main())
