#!/usr/bin/env python3
"""Generate the hermes-webui gateway key, on the host, before `docker compose up`.

Compose interpolates ${RALPH_WEBUI_API_KEY} when it parses docker-compose.yml,
on the host, before any container starts. `bootstrap/install` cannot supply it:
that script runs inside the init container, after Compose has already read the
blank default out of compose/.env.example. So this is a plain host script, run
once before the first `docker compose up -d`:

    ./bootstrap/secrets

It creates compose/.env from compose/.env.example if .env does not exist yet,
then fills in RALPH_WEBUI_API_KEY if it is missing or blank. A key already set
is left alone -- rotating a key a running hermes-webui is using would break it --
so running this twice changes nothing. Every other line in .env, comments and
order included, is left exactly as it was.
"""

from __future__ import annotations

import argparse
import re
import secrets
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# Each secret this stack needs and that a person should never have to invent.
# Hermes requires at least 16 characters of each (has_usable_secret); 64 hex
# characters is comfortably past that floor.
SECRETS = ("RALPH_WEBUI_API_KEY", "RALPH_DASHBOARD_PASSWORD")
KEY_BYTES = 32

ASSIGNMENT = re.compile(r"^([A-Z_][A-Z0-9_]*)=(.*)$")


def generate_key() -> str:
    return secrets.token_hex(KEY_BYTES)


def fill_key(text: str, key: str) -> tuple[str, bool]:
    """Set `key` in `text` if its line is missing or blank.

    A line with a non-blank value is left untouched, in place, so nothing
    else in the file moves and a secret in use is never rotated.
    """
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        match = ASSIGNMENT.match(line.rstrip("\n"))
        if match is None or match.group(1) != key:
            continue
        if match.group(2).strip():
            return text, False
        ending = "\n" if line.endswith("\n") else ""
        lines[i] = f"{key}={generate_key()}{ending}"
        return "".join(lines), True

    prefix = text if (not text or text.endswith("\n")) else text + "\n"
    return prefix + f"{key}={generate_key()}\n", True


def add_missing(text: str, example: str) -> tuple[str, list[str]]:
    """Append any variable the example has and this file does not.

    An .env written before a release that introduced a variable never gains
    it, and a required one then fails at parse time with a message that names
    the variable but not where it should have come from. Values are the
    example's own; nothing already present is touched.
    """
    have = {m.group(1) for m in (ASSIGNMENT.match(l) for l in text.splitlines()) if m}
    added = [l for l in example.splitlines()
             if (m := ASSIGNMENT.match(l)) and m.group(1) not in have]
    if not added:
        return text, []
    prefix = text if (not text or text.endswith("\n")) else text + "\n"
    block = "\n# Added from .env.example by bootstrap/secrets.\n" + "\n".join(added) + "\n"
    return prefix + block, [ASSIGNMENT.match(l).group(1) for l in added]


def write_env(env_path: Path, text: str) -> None:
    env_path.write_text(text)
    env_path.chmod(0o600)


def run(env_path: Path, example_path: Path) -> tuple[list[str], list[str]]:
    """Bring env_path up to date. Returns (variables added, secrets generated)."""
    example = example_path.read_text()
    if not env_path.exists():
        write_env(env_path, example)

    text = env_path.read_text()
    text, added = add_missing(text, example)
    generated = []
    for key in SECRETS:
        text, changed = fill_key(text, key)
        if changed:
            generated.append(key)
    if added or generated:
        write_env(env_path, text)
    return added, generated


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env", type=Path, default=ROOT / "compose" / ".env")
    parser.add_argument("--example", type=Path, default=ROOT / "compose" / ".env.example")
    args = parser.parse_args(argv)

    added, generated = run(args.env, args.example)
    # Names only, never values.
    for key in added:
        print(f"added {key} from .env.example")
    for key in SECRETS:
        print(f"generated {key}" if key in generated else f"{key} already set")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
