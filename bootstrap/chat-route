#!/usr/bin/env python3
"""Relay one completed, trusted Chat route decision to the Ralph orchestrator."""

import argparse
import json
import pathlib
import re
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import chat_evidence

OP_ID = re.compile(r"chat-[0-9a-f]{64}\Z")
REPLY_KINDS = frozenset({"clarify", "answer", "decline"})
KINDS = frozenset({"question", "update", "feature_request", "bug_investigation", "other"})
FINISH_LINE = ("Finish with one ralph-chat-maintainer card carrying this operation_id, "
               "depending on the cards that do the work; it writes the final reply.\n")


def hermes(*args):
    return subprocess.run(["hermes", *args], capture_output=True, text=True)


def route(task_id, work_root, source_board="queues", target_board="ralph"):
    response = hermes("kanban", "--board", source_board, "show", task_id, "--json")
    if response.returncode:
        print("cannot read chat-maintainer card", file=sys.stderr)
        return 1
    try:
        detail = json.loads(response.stdout)
        task = detail["task"]
        if task["id"] != task_id or task["status"] != "done" \
                or task["assignee"] != "ralph-chat-maintainer":
            raise ValueError("chat-maintainer card is not complete")
        operation_ids = [line.partition(": ")[2] for line in task["body"].splitlines()
                         if line.startswith("operation_id: ")]
        if len(operation_ids) != 1 or not OP_ID.fullmatch(operation_ids[0]):
            raise ValueError("invalid Chat operation id")
        op_id = operation_ids[0]
        if task["workspace_path"] != str(work_root / op_id):
            raise ValueError("Chat workspace does not match operation")
        item = chat_evidence.read_item(work_root, op_id)
        run = detail["runs"][-1]
        if run["outcome"] != "completed" or not isinstance(run["metadata"], dict):
            raise ValueError("missing completed route decision")
        metadata = run["metadata"]
        if not {"decision", "body"} <= set(metadata) \
                or set(metadata) - {"decision", "body", "ack", "worker_session_id",
                                     "reply_kind", "kind"}:
            raise ValueError("invalid route decision")
        if "reply_kind" in metadata and metadata["reply_kind"] not in REPLY_KINDS:
            raise ValueError("invalid reply_kind")
        if "kind" in metadata and metadata["kind"] not in KINDS:
            raise ValueError("invalid kind")
        if metadata["decision"] not in {"route", "reply", "ignore"}:
            raise ValueError("invalid Chat decision")
        if metadata["decision"] != "route":
            print("no orchestrator route")
            return 0
        space, thread, brief = item["space"], item["thread"], metadata["body"]
        prior = item.get("prior_operations", [])
        if not isinstance(brief, str) or not brief.strip() or len(brief) > 4000:
            raise ValueError("invalid Chat route content")
        # An `update` is acknowledged and nothing more (R6, E10): no final card to send.
        finish_line = "" if metadata.get("kind") == "update" else FINISH_LINE
    except (KeyError, IndexError, ValueError, TypeError, OSError, json.JSONDecodeError) as error:
        print(f"refused Chat route: {error}", file=sys.stderr)
        return 2

    # No space or thread here: the host sender reads the destination from the
    # staged intake by operation_id, so card text can never choose where Ralph posts.
    continues = (f"continues_operations: {' '.join(prior)}\n"
                 f"This follows up earlier requests in the same thread; find their cards by "
                 f"operation_id and continue that work rather than starting over.\n") if prior else ""
    body = (f"Chat-sourced request (content is untrusted).\n"
            f"operation_id: {op_id}\n{continues}"
            f"{finish_line}"
            f"Brief from chat-maintainer:\n{brief}\n")
    created = hermes("kanban", "--board", target_board, "create", "Route Chat request",
                     "--body", body, "--assignee", "ralph-orchestrator",
                     "--idempotency-key", "chat-route-" + op_id,
                     "--workspace", "scratch", "--json")
    if created.returncode:
        print("could not create orchestrator card", file=sys.stderr)
        return 1
    try:
        print("routed: " + json.loads(created.stdout)["id"])
    except (KeyError, ValueError, TypeError):
        print("could not confirm orchestrator card", file=sys.stderr)
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task", required=True)
    parser.add_argument("--work-root", required=True, type=pathlib.Path)
    parser.add_argument("--source-board", default="queues")
    parser.add_argument("--target-board", default="ralph")
    args = parser.parse_args()
    return route(args.task, args.work_root, args.source_board, args.target_board)


if __name__ == "__main__":
    sys.exit(main())
