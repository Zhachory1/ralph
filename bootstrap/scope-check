#!/usr/bin/env python3
"""Fail a pull request that changed more than it was asked to.

Scope creep is the failure mode a builder reaches for honestly. It has the
whole repository, it notices something nearby that is wrong, and fixing it
feels like doing a good job. Across a feature's PRs those additions compound
into a diff nobody agreed to, and the review that was supposed to be the
safety net becomes too large to be one.

The plan this checks against comes from the Kanban card, written before the
work started. That matters: a plan the builder declares in the same pull
request is not a constraint, it is a description of whatever it did.

Any flag fails the check. A human overrides by labelling the pull request
`scope-approved`, which is a decision with their name on it rather than a
silent default.

    scope-check --base main --head HEAD --plan plan.json
    scope-check --base main --head HEAD --card t_abc123 --board ralph
"""

from __future__ import annotations

import argparse
import fnmatch
import json
import re
import subprocess
import sys

# Files that change the build, the dependency graph, or what runs in CI.
# A builder has no business touching these unless the design said so, and
# a lockfile edit is a common way for an unrelated change to ride along.
SENSITIVE = (
    "package.json", "package-lock.json", "yarn.lock", "pnpm-lock.yaml",
    "requirements*.txt", "pyproject.toml", "poetry.lock", "uv.lock",
    "Pipfile", "Pipfile.lock", "go.mod", "go.sum", "Cargo.toml", "Cargo.lock",
    "Gemfile", "Gemfile.lock", "composer.json", "composer.lock",
    "pom.xml", "build.gradle*", "*.csproj",
    "Dockerfile*", "docker-compose*.yml", ".github/workflows/*",
    "Makefile", "justfile", "*.tf",
)

DEFAULT_MAX_LINES = 400

# One path per line, optionally as a list item and in backticks. Not required
# to have an extension: this repository's own scripts (bootstrap/install,
# bootstrap/stop, bootstrap/secrets) have none, nor does a Dockerfile, and
# demanding one silently dropped those files from every plan, so the check
# flagged as unplanned the very file the plan authorised.
PLAN_RE = re.compile(r"^\s*(?:[-*]\s+)?`?([\w.*?\[\]-]+(?:/[\w.*?\[\]-]+)*/?)`?\s*$", re.M)


def run(*args: str) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def changed_files(base: str, head: str) -> list[str]:
    out = run("git", "diff", "--name-only", f"{base}...{head}")
    return [line for line in out.splitlines() if line.strip()]


def changed_lines(base: str, head: str) -> int:
    out = run("git", "diff", "--numstat", f"{base}...{head}")
    total = 0
    for line in out.splitlines():
        added, removed, _, *_ = (line.split("\t") + ["", "", ""])[:3]
        # Binary files report "-"; they count as changed, not as zero.
        total += sum(int(n) for n in (added, removed) if n.isdigit())
    return total


def plan_from_text(text: str) -> dict:
    """Read a <planned_files> block out of whatever text holds it."""
    files, section = [], False
    for line in (text or "").splitlines():
        if re.match(r"^\s*<planned_files>", line):
            section = True
            continue
        if re.match(r"^\s*</planned_files>", line):
            section = False
            continue
        if section:
            match = PLAN_RE.match(line)
            if match:
                files.append(match.group(1))
    return {"files": files}


def plan_from_commit(base: str, head: str) -> dict:
    """Read the plan out of the commit messages on this branch.

    The plan belongs to the card, which is authored before the work starts and
    is not editable by the pull request under review. But the board is a SQLite
    file on the operator's own machine, so a CI runner cannot read it: the
    check that depends on it fails with `FileNotFoundError: 'hermes'` and tells
    nobody anything about scope.

    So the worker copies the block into its commit message, where CI can see
    it. That is weaker — a worker writes its own commit — and it is the
    strongest thing available to a runner that cannot reach the board. The
    card remains the record; `--card` still reads it where Hermes is present.
    """
    out = run("git", "log", "--format=%B", f"{base}...{head}")
    return plan_from_text(out)


def plan_from_card(board: str, card: str) -> dict:
    """Read the plan the orchestrator wrote onto the card.

    The card brief is authored before the work and is not editable by the
    pull request under review, which is the whole point. Needs the hermes CLI
    and the board, so it is for a machine that has both.
    """
    raw = run("hermes", "kanban", "--board", board, "show", card, "--json")
    detail = json.loads(raw or "{}")
    return plan_from_text((detail.get("task") or {}).get("body") or "")


def matches(path: str, patterns: list[str]) -> bool:
    """A plan entry matches a path exactly, as a directory prefix, or as a glob.

    Exact match is tried first and literally. Next.js route directories are
    named `[id]`, which fnmatch reads as a character set, so a planned
    `app/a/[id]/edit/page.tsx` would never match the file of that name and the
    check would flag the very file it authorised.
    """
    for pattern in patterns:
        if path == pattern:
            return True
        if path.startswith(pattern.rstrip("/") + "/"):
            return True
        if fnmatch.fnmatch(path, pattern):
            return True
    return False


def check(files: list[str], lines: int, plan: dict, max_lines: int) -> list[str]:
    planned = plan.get("files") or []
    allowed_new = plan.get("new_files", planned)
    flags = []

    if not planned:
        # No plan is not a pass. A card without one was never scoped, and
        # passing it silently would make the check optional in practice.
        flags.append(
            "no planned files on the card: scope cannot be checked. "
            "Add a <planned_files> block to the card brief.")
        return flags

    for path in files:
        if not matches(path, planned):
            flags.append(f"{path}: outside the planned files")

    for path in files:
        if matches(path, SENSITIVE) and not matches(path, allowed_new):
            flags.append(f"{path}: build or dependency file not in the plan")

    if lines > max_lines:
        flags.append(
            f"{lines} changed lines exceeds the {max_lines} cap: "
            "split this into stacked pull requests")

    return flags


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--head", default="HEAD")
    parser.add_argument("--plan", help="JSON file with {\"files\": [...]}")
    parser.add_argument("--card", help="Kanban card id to read the plan from")
    parser.add_argument("--from-commits", action="store_true",
                        help="Read the plan from this branch's commit messages, "
                             "for a runner that cannot reach the board")
    parser.add_argument("--board", default="ralph")
    parser.add_argument("--max-lines", type=int, default=DEFAULT_MAX_LINES)
    parser.add_argument("--labels", default="",
                        help="Comma-separated labels on the pull request")
    args = parser.parse_args(argv)

    if "scope-approved" in [l.strip() for l in args.labels.split(",")]:
        print("scope-approved: a human accepted this diff's scope")
        return 0

    if args.plan:
        plan = json.loads(open(args.plan).read())
    elif args.from_commits:
        plan = plan_from_commit(args.base, args.head)
    elif args.card:
        plan = plan_from_card(args.board, args.card)
    else:
        print("need --plan, --card or --from-commits", file=sys.stderr)
        return 64

    files = changed_files(args.base, args.head)
    lines = changed_lines(args.base, args.head)
    flags = check(files, lines, plan, args.max_lines)

    print(f"{len(files)} files, {lines} changed lines")
    print(f"planned: {', '.join(plan.get('files') or []) or '(none)'}")

    if not flags:
        print("in scope")
        return 0

    print("\nout of scope:")
    for flag in flags:
        print(f"  - {flag}")
    print("\nIf these changes are intentional, label the pull request "
          "'scope-approved'. If they are not, the card needed a scope "
          "escalation before the work started.")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
