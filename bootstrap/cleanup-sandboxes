#!/usr/bin/env python3
"""Free sandbox disk: finished cards' checkouts, then oversized package caches.

A script, not an agent (#97): the rules are fixed, and an agent would need
delete rights over every profile's sandbox. Run by bootstrap/run-review-loop,
at most once an hour.

    cleanup-sandboxes --root /workspaces/sandboxes [--dry-run]

Under the root, each profile has `<profile>/docker/default/{workspace,home}`.

1. Checkouts. A `workspace/t_<id>` directory whose card is done or archived on
   any board, and untouched for CHECKOUT_AGE_SECONDS, is deleted. A card that
   is todo, ready, running or blocked -- or that no board knows -- is kept.
2. Caches. When a profile's `home` exceeds HOME_LIMIT_BYTES and the profile has
   no card in flight (todo, ready, running or blocked), its package caches are
   deleted: `.cache`, `.npm`, and Go's module cache `go/pkg/mod` -- never
   `go/bin`, where installed tools live. They rebuild on next use.

The repository cache is never touched: clones borrow its objects (#79).
"""

import argparse
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

FINISHED = {"done", "archived"}
CHECKOUT_AGE_SECONDS = 3600
HOME_LIMIT_BYTES = 5 * 1024 ** 3
CACHE_DIRS = (".cache", ".npm", "go/pkg/mod")
IN_FLIGHT = {"todo", "ready", "running", "blocked"}
CARD_DIR = re.compile(r"^t_[0-9a-f]+$")


def hermes(*args):
    container = os.environ.get("RALPH_HERMES_CONTAINER")
    argv = ["hermes", *args]
    if container:
        argv = ["docker", "exec", "-u", "hermes", container, *argv]
    return subprocess.run(argv, capture_output=True, text=True, timeout=120)


def boards():
    """Every board Hermes knows, not a fixed list. None if unreadable."""
    r = hermes("kanban", "boards", "list", "--json")
    if r.returncode != 0:
        return None
    try:
        # Archived boards too: their cards' checkouts are still on disk.
        return [b["slug"] for b in json.loads(r.stdout)]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None


def card_states():
    """{card id: status} across every board, archived included, and the set of
    profiles with a card in flight -- not only running: a ready card can be
    dispatched while caches are being deleted. None if any board cannot be
    read: deleting on a partial view could remove a live card's checkout."""
    states, busy = {}, set()
    slugs = boards()
    if slugs is None:
        return None
    for board in slugs:
        r = hermes("kanban", "--board", board, "list", "--archived", "--json")
        if r.returncode != 0:
            return None
        try:
            cards = json.loads(r.stdout)
        except json.JSONDecodeError:
            return None
        for card in cards if isinstance(cards, list) else cards.get("tasks", []):
            states[card["id"]] = card.get("status")
            if card.get("status") in IN_FLIGHT and card.get("assignee"):
                busy.add(card["assignee"])
    return states, busy


def size_of(path):
    total = 0
    for dirpath, _, files in os.walk(path, onerror=lambda e: None):
        for name in files:
            try:
                total += os.lstat(os.path.join(dirpath, name)).st_size
            except OSError:
                pass
    return total


def newest_mtime(path):
    newest = path.lstat().st_mtime
    for dirpath, dirs, files in os.walk(path, onerror=lambda e: None):
        for name in dirs + files:
            try:
                newest = max(newest, os.lstat(os.path.join(dirpath, name)).st_mtime)
            except OSError:
                pass
    return newest


def remove(path, dry_run):
    freed = size_of(path)
    if not dry_run:
        shutil.rmtree(path, ignore_errors=True)
    return freed


def clean(root, states, busy, now, dry_run):
    """Returns [(path, bytes freed, reason)]."""
    removed = []
    for profile_dir in sorted(p for p in root.iterdir() if p.is_dir()):
        base = profile_dir / "docker" / "default"
        workspace = base / "workspace"
        if workspace.is_dir():
            for checkout in sorted(workspace.iterdir()):
                if not (checkout.is_dir() and CARD_DIR.match(checkout.name)):
                    continue
                if states.get(checkout.name) not in FINISHED:
                    continue
                if now - newest_mtime(checkout) < CHECKOUT_AGE_SECONDS:
                    continue
                removed.append((checkout, remove(checkout, dry_run), "finished card"))
        home = base / "home"
        if home.is_dir() and profile_dir.name not in busy \
                and size_of(home) > HOME_LIMIT_BYTES:
            for name in CACHE_DIRS:
                cache = home / name
                if cache.is_dir() and not cache.is_symlink():
                    removed.append((cache, remove(cache, dry_run), "home over limit"))
    return removed


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", required=True, type=pathlib.Path)
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    if not args.root.is_dir():
        print(f"cleanup: {args.root} does not exist; nothing to do")
        return 0
    view = card_states()
    if view is None:
        print("cleanup: could not read every board; deleting nothing", file=sys.stderr)
        return 1
    states, busy = view
    removed = clean(args.root, states, busy, time.time(), args.dry_run)
    verb = "would free" if args.dry_run else "freed"
    for path, freed, reason in removed:
        print(f"cleanup: {verb} {freed / 1024 ** 2:.0f} MB {path} ({reason})")
    total = sum(freed for _, freed, _ in removed)
    print(f"cleanup: {verb} {total / 1024 ** 3:.2f} GB in {len(removed)} item(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
