#!/usr/bin/env bash
# The Chat sidecar entrypoint: the producer, then the sender, every interval.
#
# A loop rather than a cron entry, the same shape as run-notifier and
# run-review-loop: a crash shows as a restarting container, not a silently
# missing job (run-notifier:4-5, run-review-loop:3-4). One failing pass must
# not stop the next; neither command here ever blocks a card to paper over a
# nonzero exit -- that is chat-reply's own job, and it already keeps a
# retryable failure off the blocked list (chat-reply:335-349).

set -uo pipefail

INSTANCE_ENV=${RALPH_CHAT_INSTANCE_ENV:-/var/lib/ralph/chat-instance.env}
INTERVAL=${RALPH_CHAT_POLL_SECONDS:-60}
# Overridable only by the eval that drives this loop with a fake command and
# a bounded iteration count; the container never sets either.
PRODUCER_CMD=${RALPH_CHAT_PRODUCER_CMD:-"python3 /ralph/bootstrap/chat-producer --instance-env $INSTANCE_ENV --once"}
SENDER_CMD=${RALPH_CHAT_SENDER_CMD:-"python3 /ralph/bootstrap/chat-reply --scan --instance-env $INSTANCE_ENV"}
# 0 (the default) is unbounded; the eval above sets a real count.
MAX_ITERATIONS=${RALPH_CHAT_MAX_ITERATIONS:-0}
# The sidecar does nothing until the owner's one-time token copy
# (bootstrap/chat-creds-copy) has put a token here. That copy `docker exec`s
# into this running container, so the container has to exist first; waiting
# for the token, rather than failing every pass without one, is what makes
# starting it before the copy safe: no Chat read, no reply, no alert.
TOKEN_FILE=${RALPH_CHAT_TOKEN_FILE:-/root/.config/gws-cli/chat_token.json.enc}
# One pass may not hold the loop: a hung Chat read in the producer would
# otherwise stop the sender from ever running again. `timeout` ends it (exit
# 124), the next command runs, and the next interval retries both.
PASS_TIMEOUT=${RALPH_CHAT_PASS_TIMEOUT_SECONDS:-120}

# chat-producer and chat-reply both take one `--instance-env` file
# (chat-producer:300, chat-reply:529); this service carries its variables as
# container environment instead (dd-chat.md:408-410), so render them into
# that file once at start. RALPH_WORKSPACES is this container's own absolute
# mount point, not the host-relative path in compose/.env.example:
# `instance_config()` joins it onto the env file's directory
# (chat-reply:114), and an absolute operand replaces that join outright, so
# the root always resolves to /workspaces regardless of where this file
# lives (chat-producer:88, chat-reply:114).
render_instance_env() {
    umask 077
    mkdir -p "$(dirname "$INSTANCE_ENV")"
    {
        echo "RALPH_INSTANCE=${RALPH_INSTANCE:-ralph}"
        echo "RALPH_WORKSPACES=/workspaces"
        echo "CHAT_ROUTE_SPACES=${CHAT_ROUTE_SPACES:-}"
        echo "CHAT_SEND=${CHAT_SEND:-on}"
        if [ -n "${RALPH_TRACKER_HOST:-}" ]; then
            echo "RALPH_TRACKER_HOST=${RALPH_TRACKER_HOST}"
        fi
    } > "$INSTANCE_ENV"
}

render_instance_env
echo "ralph chat sidecar: instance=${RALPH_INSTANCE:-ralph} every ${INTERVAL}s"

iteration=0
announced_wait=0
while true; do
    if [ ! -f "$TOKEN_FILE" ]; then
        if [ "$announced_wait" -eq 0 ]; then
            echo "chat sidecar: no Chat token at $TOKEN_FILE yet; idle until bootstrap/chat-creds-copy has run" >&2
            announced_wait=1
        fi
    else
        announced_wait=0
        # shellcheck disable=SC2086  # the *_CMD values are trusted, operator-set strings
        eval "timeout $PASS_TIMEOUT $PRODUCER_CMD" || echo "chat sidecar: producer pass failed or timed out, will retry" >&2
        eval "timeout $PASS_TIMEOUT $SENDER_CMD" || echo "chat sidecar: sender pass failed or timed out, will retry" >&2
    fi

    iteration=$((iteration + 1))
    if [ "$MAX_ITERATIONS" -gt 0 ] && [ "$iteration" -ge "$MAX_ITERATIONS" ]; then
        break
    fi
    sleep "$INTERVAL"
done
exit 0
