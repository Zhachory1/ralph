# The knowledge service: QMD over this instance's docs repository (#121).
#
# One process per instance loads the embedding and re-rank models once and
# serves every profile over HTTP MCP. CPU only: the VM has no GPU. Query
# expansion is off by design (dd-ralph-knowledge D4); agents send typed
# lex/vec sub-queries, so its 1.3 GB model is never downloaded.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates sqlite3 python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

ARG QMD_VERSION=2.8.3
RUN npm install -g "@tobilu/qmd@${QMD_VERSION}" && qmd --version

# Everything QMD writes lives in the instance's knowledge volume.
ENV KNOWLEDGE_ROOT=/var/lib/ralph-knowledge \
    XDG_CACHE_HOME=/var/lib/ralph-knowledge/cache \
    QMD_CONFIG_DIR=/var/lib/ralph-knowledge/config \
    INDEX_PATH=/var/lib/ralph-knowledge/cache/qmd/index.sqlite \
    QMD_FORCE_CPU=1
WORKDIR /var/lib/ralph-knowledge

# A fresh volume has no folders yet, and QMD will not create the index's
# parent directory before opening it.
CMD ["sh", "-c", "mkdir -p \"$(dirname \"$INDEX_PATH\")\" \"$QMD_CONFIG_DIR\" \"$KNOWLEDGE_ROOT/repo\" && exec qmd mcp --http --host 0.0.0.0 --port 8181"]
