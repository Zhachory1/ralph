# Copy to .env and fill in. Never commit the result.

# Pin the Hermes image. Compose refuses to start without this, by design:
# `latest` turns an upgrade into a surprise.
HERMES_VERSION=v0.22.2

# Ralph's own image tag, built from this repo.
RALPH_VERSION=dev

# Google Chat incoming webhook. A credential: anyone holding it can post
# into the space. Keep it out of the repo and rotate it if it leaks.
GCHAT_WEBHOOK_URL=

# GitHub token used for repository work: reading pull requests, pushing
# branches, applying labels. Needs access to the repos Ralph works in.
RALPH_GITHUB_TOKEN=

# Model provider credentials. Supply whichever your provider needs.
#
# Hermes picks up GH_TOKEN as a GitHub Copilot credential, so if you reach
# Claude through Copilot this is a GitHub token on an account holding a
# Copilot licence. That is often a different account from the one owning
# your repositories, which is why the two are separate settings here.
GH_TOKEN=
ANTHROPIC_API_KEY=

# Repositories Ralph opens pull requests in, space separated. The kill switch
# drafts open agent-authored PRs in these during a Stop.
RALPH_REPOS=

# Optional.
RALPH_BOARD=ralph
RALPH_POLL_SECONDS=900
RALPH_DASHBOARD_PORT=9219
RALPH_WORKSPACES=./workspaces
