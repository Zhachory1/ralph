# Copy to .env and fill in. Never commit the result.
#
# One file per Ralph instance. Run a second one from the same checkout with
#   RALPH_ENV_FILE=.env.work docker compose --env-file .env.work up -d
# where .env.work sets its own RALPH_INSTANCE, ports and credentials.

# ── Instance: who this Ralph is ─────────────────────────────────────────────

# Names the compose project, so containers, network and volumes. Two
# instances must differ here, and in both ports below. Changing it on a
# running instance starts a fresh one with empty volumes.
RALPH_INSTANCE=ralph
RALPH_DASHBOARD_PORT=9219
# hermes-webui's chat space, localhost only.
RALPH_WEBUI_PORT=9220
# Clone cache, review work and staging. Two instances must not share one.
RALPH_WORKSPACES=./workspaces

# ── Identity: the GitHub account this instance acts as ──────────────────────

# Repository work: reading pull requests, posting reviews, pushing branches.
# Needs access to every repository in scope below.
RALPH_GITHUB_TOKEN=
# The account RALPH_GITHUB_TOKEN must authenticate as. The review loop
# refuses to start on a mismatch. Blank skips the check.
RALPH_GITHUB_LOGIN=
RALPH_GIT_NAME=Ralph
RALPH_GIT_EMAIL=ralph@localhost

# Maintenance: the account whose open PRs Ralph maintains, and a token that
# pushes as it. A different account from RALPH_GITHUB_TOKEN's, which posts the
# reviews -- the maintainer ignores its own account's feedback. Use a
# fine-grained token scoped to the repositories you want maintained, with
# Contents and Pull requests read/write. Leave both blank to disable.
RALPH_MAINTAIN_LOGIN=
RALPH_MAINTAIN_TOKEN=

# ── Scope: what this instance may touch ─────────────────────────────────────

# Space separated; owner/* grants every repository of an owner. Set, these
# override the allowlist files bootstrap/cutover-repo writes. Maintenance
# defaults to the review scope.
RALPH_REVIEW_ALLOW=
RALPH_MAINTAIN_ALLOW=
# Repositories Ralph opens pull requests in. The kill switch drafts open
# agent-authored PRs in these during a Stop.
RALPH_REPOS=
# Private skills overlay, mounted read-only. Blank means a rokt-it-ralph
# checkout beside this one. For none, name a path that does not exist, e.g.
# ./no-private-skills: Docker mounts it as an empty directory.
RALPH_PRIVATE_SKILLS=

# ── Model provider: only what this instance uses ────────────────────────────

ANTHROPIC_API_KEY=
# Hermes reads GH_TOKEN as a GitHub Copilot credential. Set it only if you
# reach a model through Copilot; it is never used for repository work.
GH_TOKEN=
# Only for the review-lens queue: the five lenses run on this provider. Set a
# monthly spend cap on the key with the provider; this repository cannot.
RALPH_OPENAI_API_KEY=

# ── Channels: how this instance talks to you ────────────────────────────────

# Incoming webhook for alerts and the morning digest (Google Chat today). A
# credential: anyone holding it can post into the space. Rotate it if it
# leaks. Blank means log only. GCHAT_WEBHOOK_URL is the old name and still
# works; this one wins when both are set.
RALPH_NOTIFY_URL=

# ── Stack secrets: generated by ./bootstrap/secrets ─────────────────────────

# The dashboard's login. Hermes refuses to start its dashboard on a
# non-loopback bind without an auth provider, and it binds 0.0.0.0 inside
# its container so the published port can reach it; the port itself is
# still published on 127.0.0.1 only.
RALPH_DASHBOARD_USER=ralph
RALPH_DASHBOARD_PASSWORD=
# Shared secret (16+ chars) that lets hermes-webui's gateway health check
# authenticate to the hermes service's API server. Blank skips the gateway
# API: hermes-webui still starts, its gateway status just reads "unreachable".
RALPH_WEBUI_API_KEY=

# ── Versions ────────────────────────────────────────────────────────────────

# Pin the Hermes image. Compose refuses to start without this, by design:
# `latest` turns an upgrade into a surprise.
HERMES_VERSION=v0.22.2
# Pin hermes-webui to match. No compatibility matrix exists between the two
# projects (hermes-webui's own docs call this an untested "release pair"),
# so bumping HERMES_VERSION without re-qualifying and bumping this one is
# the cost this pairing warns about, not a formality.
HERMES_WEBUI_VERSION=0.52.492
# Ralph's own image tag, built from this repo.
RALPH_VERSION=dev

# ── Tuning: optional, defaults shown ────────────────────────────────────────

RALPH_BOARD=ralph
RALPH_POLL_SECONDS=900
# Cards running at once in this instance. Instances share one VM, so these
# add up across instances: size them together against its memory.
RALPH_MAX_IN_PROGRESS=6
# One sandbox's memory ceiling, MB. A large-repo build peaks at several GB.
RALPH_SANDBOX_MEMORY_MB=3072
# Hours between Ralph's reviews of one PR. A PR pushed again sooner waits,
# then is reviewed once at its latest head. Max 3 rounds per PR either way.
RALPH_REVIEW_SPACING_HOURS=24
# Local hour the morning digest goes out, once a day.
RALPH_DIGEST_HOUR=8
# A private package registry token, when a repository needs one to install.
BUF_TOKEN=
