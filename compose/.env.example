# Copy to .env and fill in. Never commit the result.

# Pin the Hermes image. Compose refuses to start without this, by design:
# `latest` turns an upgrade into a surprise.
HERMES_VERSION=v0.22.2

# Pin hermes-webui to match. No compatibility matrix exists between the two
# projects (hermes-webui's own docs call this an untested "release pair"),
# so bumping HERMES_VERSION without re-qualifying and bumping this one is
# the cost this pairing warns about, not a formality.
HERMES_WEBUI_VERSION=0.52.492

# Ralph's own image tag, built from this repo.
RALPH_VERSION=dev

# Google Chat incoming webhook. A credential: anyone holding it can post
# into the space. Keep it out of the repo and rotate it if it leaks.
GCHAT_WEBHOOK_URL=

# GitHub token used for repository work: reading pull requests, pushing
# branches, applying labels. Needs access to the repos Ralph works in.
RALPH_GITHUB_TOKEN=

# Model provider credentials. Supply whichever your provider needs.
#
# Hermes picks up GH_TOKEN as a GitHub Copilot credential, so if you reach
# Claude through Copilot this is a GitHub token on an account holding a
# Copilot licence. That is often a different account from the one owning
# your repositories, which is why the two are separate settings here.
GH_TOKEN=
ANTHROPIC_API_KEY=

# Only needed if you run the review-lens queue (fleet-into-ralph design, PR 2
# onward). The five review lenses run on this provider; Ralph's other nine
# profiles never touch it and stay on ANTHROPIC_API_KEY above. Set a monthly
# spend cap on this key with the provider directly -- that is bound 4 of the
# queue's four spending bounds, and it is deliberately not something this
# repository can enforce. Leave blank if you are not running review lenses.
RALPH_OPENAI_API_KEY=

# Maintenance: the account whose open PRs Ralph maintains, and a token that
# pushes as it. A different account from RALPH_GITHUB_TOKEN's, which posts the
# reviews -- the maintainer ignores its own account's feedback. Use a
# fine-grained token scoped to the repositories you want maintained, with
# Contents and Pull requests read/write. Leave both blank to disable.
RALPH_MAINTAIN_LOGIN=
RALPH_MAINTAIN_TOKEN=

# Repositories Ralph opens pull requests in, space separated. The kill switch
# drafts open agent-authored PRs in these during a Stop.
RALPH_REPOS=

# A private package registry token, when a repository needs one to install.
# Without it the sandbox cannot build the app it is changing.
BUF_TOKEN=

# Shared secret (16+ chars) that lets hermes-webui's gateway health check
# authenticate to the hermes service's API server. `./bootstrap/secrets`
# generates one before the first `docker compose up -d`; a blank value here
# skips the gateway API instead: hermes-webui still starts, its gateway
# status just reads "unreachable".
RALPH_WEBUI_API_KEY=

# The dashboard's login. Hermes refuses to start its dashboard on a
# non-loopback bind without an auth provider, and it binds 0.0.0.0 inside
# its container so the published port can reach it; the port itself is
# still published on 127.0.0.1 only. The password is generated by
# bootstrap/secrets; the username may be anything.
RALPH_DASHBOARD_USER=ralph
RALPH_DASHBOARD_PASSWORD=

# Optional.
RALPH_BOARD=ralph
RALPH_POLL_SECONDS=900

# Local hour the morning digest goes out, once a day.
RALPH_DIGEST_HOUR=8
RALPH_DASHBOARD_PORT=9219
RALPH_WORKSPACES=./workspaces

# hermes-webui's chat space, localhost only. Different from the dashboard
# port above so the two can run side by side.
RALPH_WEBUI_PORT=9220
