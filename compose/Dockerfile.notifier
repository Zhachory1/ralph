# The notifier: two stdlib Python scripts that poll a board and a GitHub API.
#
# It used to run on the Hermes image, which costs 4.5GB to carry a CLI it
# invokes a handful of times. It reaches the board over Kanban's SQLite file
# instead, through the hermes container, so all it needs is Python and gh.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg docker-cli git \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /var/lib/ralph

# The Chat sidecar (chat-sender) imports skills/ops/google-chat/gchat.py
# directly rather than through its own `uv run` isolation (chat-producer:9-13,
# chat-reply:128), so this image needs the four packages gchat.py's PEP 723
# header pins (gchat.py:3-8) in its ambient Python -- the same versions
# .github/workflows/chat.yml already installs for test_gchat_send.py.
# Extending this image rather than carrying a second one (dd-chat.md:406-407).
RUN pip install --no-cache-dir \
      "google-api-python-client>=2.100" \
      "google-auth-oauthlib>=1.2" \
      "google-auth>=2.30" \
      "cryptography>=42"

# A fixed id for every container built from this image: the slim base image
# ships no /etc/machine-id (no dbus), and gchat.py's token key derives from
# this file plus the container's own user (gchat.py:106-114). Without a
# stable value here, a Chat token copied in once (bootstrap/chat-creds-copy,
# D8) would stop decrypting on the next restart or rebuild. notifier and
# review-loop share this image but never read a Chat token, so the file is
# inert for them.
RUN echo -n "ralph-chat-sender" > /etc/machine-id
