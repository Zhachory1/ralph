+        sql`${heartbeatRuns.contextSnapshot}->>'recoveryActionId' = ${scope.context.recoveryActionId}`,
+        sql`${heartbeatRuns.contextSnapshot}->>'dispositionRepairFingerprint' = ${scope.context.dispositionRepairFingerprint}`,
