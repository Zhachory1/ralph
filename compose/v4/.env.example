# Copy to .env and fill in. Never commit the result.
#
# Scope of this file: the three new control-plane services only (postgres,
# vikunja, n8n). Hermes and its profiles still read compose/.env; this is a
# separate stack, deliberately, until a later slice merges them.

RALPH_V4_INSTANCE=ralph-v4

POSTGRES_USER=ralph
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

VIKUNJA_PORT=3456

N8N_PORT=5678

# Pin every image. Never `latest`.
POSTGRES_VERSION=pg17
VIKUNJA_VERSION=0.24.6
N8N_VERSION=1.70.3
