# The sandbox the builder's commands run in.
#
# Hermes' stock sandbox has no git and no gh, so an agent can write code in it
# but cannot branch, push, or open a pull request — which is most of the job.
# Every tool in here is reachable by untrusted code from a dependency install
# or an injected Makefile, so the list stays short and each entry earns itself.
FROM nousresearch/hermes-sandbox:desktop

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Chromium, for repositories whose screenshot rule an agent has to satisfy
# itself. 587MB on top of the base and about 16 seconds to build, in its own
# layer so editing anything above does not rebuild it. It costs nothing at
# rest: a build that never captures never launches it.
#
# A browser is the widest thing in this image — it fetches URLs and renders
# untrusted markup. It is here because an agent that cannot produce the
# screenshots its repository requires cannot finish a pull request, and the
# sandbox has no host access and no credential beyond the repository token.
# fonts-liberation so a capture renders text rather than boxes.
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

# mise, so a repository's own toolchain pins decide what runs.
#
# Without this the sandbox uses whatever Node the base image ships, which is
# not what the repository pins and not what CI runs. That is not a detail: it
# sent one investigation an hour down the wrong path, and forced a test run to
# carry NODE_OPTIONS=--no-experimental-webstorage because a newer Node shadowed
# jsdom's localStorage. An agent reasoning about a fault in the wrong runtime
# reaches confident wrong conclusions.
#
# `mise install` in a checkout reads its mise.toml and fetches the pinned
# versions; `mise exec --` then runs a command under them.
RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh \
 && /usr/local/bin/mise --version
ENV MISE_DATA_DIR=/root/.local/share/mise
